@page "/login"
@inject UserService UserService
@inject CustomAuthStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Login - Lyceum</PageTitle>

<MudCard Class="pa-8 rounded-xl border" Elevation="0" Style="max-width: 460px; width: 100%; background-color: white;">
    <div class="d-flex align-center gap-3 mb-6">
        <div class="d-flex align-center justify-center rounded-lg" style="width: 32px; height: 32px; background-color: var(--mud-palette-primary); color: white; font-weight: 800; font-size: 1.15rem; font-family: 'Outfit', sans-serif;">L</div>
        <MudText Typo="Typo.h6" Class="font-weight-bold text-dark" Style="font-family: 'Outfit', sans-serif;">Lyceum</MudText>
    </div>

    <MudText Typo="Typo.h5" Class="font-weight-bold mb-1" Style="font-family: 'Outfit', sans-serif;">Sign in to Lyceum</MudText>
    <MudText Typo="Typo.body2" Class="mb-6 text-secondary">Please enter your credentials to access your portal.</MudText>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-6 rounded-lg" Elevation="0">
            @errorMessage
        </MudAlert>
    }

    <EditForm Model="loginModel" OnValidSubmit="HandleLogin" FormName="LoginForm">
        <DataAnnotationsValidator />

        <div class="mb-4">
            <MudTextField Label="Institutional Email" @bind-Value="loginModel.Username" 
                          For="() => loginModel.Username" Variant="Variant.Outlined" 
                          Placeholder="you@university.edu" Required="true" 
                          InputType="InputType.Text" Margin="Margin.Dense" />
        </div>

        <div class="mb-2">
            <MudTextField Label="Password" @bind-Value="loginModel.Password" 
                          For="() => loginModel.Password" Variant="Variant.Outlined" 
                          Placeholder="********" Required="true" 
                          InputType="InputType.Password" Margin="Margin.Dense" />
        </div>

        <div class="d-flex justify-end mb-6">
            <MudLink href="#" Underline="Underline.Hover" Typo="Typo.body2" Color="Color.Primary" Style="font-weight: 600;">Forgot password?</MudLink>
        </div>

        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" 
                   FullWidth="true" Class="py-3 rounded-lg font-weight-bold" Style="text-transform: none; font-size: 0.95rem;" 
                   Disabled="@isLoading">
            @if (isLoading)
            {
                <MudProgressCircular Size="Size.Small" Color="Color.Default" Indeterminate="true" Class="mr-2" />
                <span>Signing in...</span>
            }
            else
            {
                <span>Sign In</span>
            }
        </MudButton>
    </EditForm>

    <div class="d-flex align-center justify-center mt-6">
        <MudText Typo="Typo.body2" Class="text-secondary mr-1">Don't have an account?</MudText>
        <MudLink Href="/register" Underline="Underline.Hover" Typo="Typo.body2" Color="Color.Primary" Style="font-weight: 700;">Create one &rarr;</MudLink>
    </div>
</MudCard>

@code {
    private LoginViewModel loginModel = new();
    private string? errorMessage;
    private bool isLoading;

    private async Task HandleLogin()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var user = await UserService.AuthenticateAsync(loginModel.Username, loginModel.Password);
            if (user != null)
            {
                await AuthStateProvider.MarkUserAsAuthenticated(user);

                // Redirect based on role
                switch (user.Role)
                {
                    case UserRole.Admin:
                        Navigation.NavigateTo("/admin/dashboard");
                        break;
                    case UserRole.Teacher:
                        Navigation.NavigateTo("/teacher/dashboard");
                        break;
                    case UserRole.Student:
                    default:
                        Navigation.NavigateTo("/student/dashboard");
                        break;
                }
            }
            else
            {
                errorMessage = "Invalid username or password.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    public class LoginViewModel
    {
        [Required(ErrorMessage = "Username is required")]
        public string Username { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password is required")]
        public string Password { get; set; } = string.Empty;
    }
}

@page "/login"
@inject NavigationManager Navigation

<PageTitle>Login - Lyceum</PageTitle>

<div class="auth-card-modern">
    <div class="logo-container">
        <div class="logo-box-modern">L</div>
        <span class="logo-text-modern">Lyceum</span>
    </div>

    <h1 class="auth-title-modern">Sign in to Lyceum</h1>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="auth-alert-modern mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill auth-alert-icon"></i>
            <div>@errorMessage</div>
        </div>
    }

    <form method="post" action="/api/auth/login" class="rz-form">
        <div class="mb-3">
            <label class="label-modern">Username or Email</label>
            <input type="text" name="username" class="input-modern form-control" placeholder="username or email" required />
        </div>

        <div class="mb-3">
            <label class="label-modern">Password</label>
            <input type="password" name="password" class="input-modern form-control" placeholder="********" required />
        </div>

        <button type="submit" class="btn-signin-modern w-100 btn btn-primary mt-2">
            Sign In
        </button>
    </form>

    <div class="auth-footer-text mt-4">
        <span>Don't have an account? </span>
        <a href="/register" class="link-signup-modern">Create one &rarr;</a>
    </div>
</div>

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    private string? errorMessage;

    protected override void OnInitialized()
    {
        if (Error == "Invalid credentials")
        {
            errorMessage = "Invalid username or password.";
        }
    }
}

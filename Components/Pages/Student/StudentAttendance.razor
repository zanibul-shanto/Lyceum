@page "/student/attendance"
@inject StudentService StudentService
@inject AttendanceService AttendanceService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Attendance - Lyceum</PageTitle>

<AuthorizeView Roles="Student" Context="authContext">
    <Authorized>
        <div class="container-fluid p-0">
            <!-- Premium Seamless Page Header -->
            <div class="premium-page-header mb-4">
                <div>
                    <h1 class="page-title-modern">Attendance Summary</h1>
                    <div class="page-subtitle-modern">Track your daily presence and course-specific attendance rates</div>
                </div>
            </div>

            @if (loading)
            {
                <div class="d-flex flex-column align-items-center justify-content-center py-5">
                    <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Medium" />
                    <p class="mt-3 text-secondary fw-semibold">Loading attendance details...</p>
                </div>
            }
            else if (currentStudent == null)
            {
                <div class="dashboard-card p-5 text-center">
                    <p class="text-secondary mb-0">Student details could not be found.</p>
                </div>
            }
            else
            {
                <div class="row g-4 mb-4">
                    <!-- Overall Attendance KPI Card -->
                    <div class="col-12 col-md-4">
                        <div class="kpi-card h-100 p-4 text-center d-flex flex-column justify-content-center align-items-center">
                            <div class="kpi-label">Overall Attendance Rate</div>
                            <div class="kpi-number my-2 text-primary font-outfit">@overallPercentage.ToString("0.1")%</div>
                            <div class="kpi-footer text-secondary">
                                Present & Late sessions included
                            </div>
                        </div>
                    </div>

                    <!-- Attendance by Course Progress Bars -->
                    <div class="col-12 col-md-8">
                        <div class="dashboard-card p-4 h-100">
                            <h5 class="fw-bold text-dark mb-4"><i class="bi bi-journal-bookmark me-2 text-success"></i>Attendance per Course</h5>
                            @if (courseAttendanceRates.Count > 0)
                            {
                                <div class="row g-3">
                                    @foreach (var item in courseAttendanceRates)
                                    {
                                        <div class="col-12">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <div>
                                                    <span class="fw-bold text-dark me-2 small">@item.CourseCode</span>
                                                    <span class="text-secondary small">@item.CourseName</span>
                                                </div>
                                                <span class="fw-semibold text-primary font-monospace small">@item.Rate.ToString("0.1")%</span>
                                            </div>
                                            <div class="course-progress-bar-container" style="height: 10px;">
                                                <div class="course-progress-bar-fill @GetProgressColorClass(item.Rate)" style="width: @item.Rate%;"></div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="text-secondary small mb-0">No active course attendance records found.</p>
                            }
                        </div>
                    </div>
                </div>

                <!-- Detailed History Table -->
                <div class="grades-card-modern p-4">
                    <h5 class="grades-card-title mb-4"><i class="bi bi-clock-history me-2 text-primary"></i>Detailed Attendance History</h5>
                    @if (attendanceRecords.Count > 0)
                    {
                        <RadzenDataGrid Data="@attendanceRecords" TItem="AttendanceRecord" AllowPaging="true" PageSize="10" GridLines="DataGridGridLines.Horizontal">
                            <Columns>
                                <RadzenDataGridColumn TItem="AttendanceRecord" Title="Date" Width="140px">
                                    <Template Context="record">
                                        <span class="fw-semibold">@record.Session.SessionDate.ToLocalTime().ToString("MMM dd, yyyy")</span>
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="AttendanceRecord" Property="Session.Course.CourseCode" Title="Course Code" Width="120px" />
                                <RadzenDataGridColumn TItem="AttendanceRecord" Property="Session.Course.Name" Title="Course Name" />
                                <RadzenDataGridColumn TItem="AttendanceRecord" Title="Status" Width="110px" TextAlign="TextAlign.Center">
                                    <Template Context="record">
                                        <span class="badge-status-modern @GetStatusBadgeClass(record.Status)">
                                            @record.Status
                                        </span>
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="AttendanceRecord" Property="Notes" Title="Notes">
                                    <Template Context="record">
                                        <span class="text-secondary small">@(string.IsNullOrWhiteSpace(record.Notes) ? "—" : record.Notes)</span>
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    }
                    else
                    {
                        <p class="text-secondary mb-0">No attendance sessions marked yet.</p>
                    }
                </div>
            }
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="d-flex flex-column align-items-center justify-content-center portal-loading-container">
            <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Large" />
            <p class="mt-3 text-secondary fw-semibold">Loading Student Portal...</p>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool loading = true;
    private Student? currentStudent;
    private double overallPercentage = 100.0;
    private List<CourseAttendanceItem> courseAttendanceRates = new();
    private List<AttendanceRecord> attendanceRecords = new();

    public class CourseAttendanceItem
    {
        public string CourseCode { get; set; } = "";
        public string CourseName { get; set; } = "";
        public double Rate { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var username = authState.User.Identity?.Name;

        if (!string.IsNullOrEmpty(username))
        {
            var userIdClaim = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
            if (userIdClaim != null && int.TryParse(userIdClaim.Value, out var userId))
            {
                currentStudent = await StudentService.GetByUserIdAsync(userId);
            }
        }

        if (currentStudent != null)
        {
            overallPercentage = await AttendanceService.GetOverallAttendancePercentageAsync(currentStudent.Id);
            attendanceRecords = await AttendanceService.GetStudentAttendanceAsync(currentStudent.Id);

            var rateDict = await AttendanceService.GetAttendancePercentageByCoursesAsync(currentStudent.Id);
            var activeEnrollments = currentStudent.Enrollments.Where(e => e.Status == EnrollmentStatus.Active).ToList();

            courseAttendanceRates = activeEnrollments
                .Select(e => new CourseAttendanceItem
                {
                    CourseCode = e.Course.CourseCode,
                    CourseName = e.Course.Name,
                    Rate = rateDict.TryGetValue(e.CourseId, out var rate) ? rate : 100.0
                })
                .ToList();
        }
        loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated != true)
            {
                Navigation.NavigateTo("/login");
            }
            else
            {
                var role = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
                if (role != "Student")
                {
                    Navigation.NavigateTo("/login");
                }
            }
        }
    }

    private string GetStatusBadgeClass(AttendanceStatus status)
    {
        return status switch
        {
            AttendanceStatus.Present => "badge-status-graded", // reuse existing success/green styles
            AttendanceStatus.Absent => "badge-status-absent bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 rounded-pill small",
            AttendanceStatus.Late => "badge-status-pending bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1 rounded-pill small",
            _ => "badge-status-pending"
        };
    }

    private string GetProgressColorClass(double rate)
    {
        return rate switch
        {
            >= 90 => "bg-success",
            >= 75 => "bg-info",
            >= 60 => "bg-warning",
            _ => "bg-danger"
        };
    }
}

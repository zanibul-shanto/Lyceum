@page "/student/dashboard"
@inject UserService UserService
@inject StudentService StudentService
@inject AttendanceService AttendanceService
@inject GradeService GradeService
@inject SystemSettingService SystemSettingService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Student Dashboard - Lyceum</PageTitle>

<AuthorizeView Roles="Student" Context="authContext">
    <Authorized>
        <div class="container-fluid p-0">
            <!-- Premium Seamless Page Header -->
            <div class="premium-page-header">
                <div>
                    <h1 class="page-title-modern">Dashboard</h1>
                    <div class="page-subtitle-modern">Academic Year: @academicYear</div>
                </div>
                <div class="header-right-block">
                    <!-- Outlined Header Profile Card matching design -->
                    <div class="header-profile-card">
                        <div class="header-avatar-circle">
                            @GetInitials(currentStudent?.User?.FullName ?? "Alex Chen")
                        </div>
                        <div>
                            <div class="header-user-name">@(currentStudent?.User?.FullName ?? "Alex Chen")</div>
                            <div class="header-user-role">Student</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Top KPI Widgets Row (4 Cards) -->
            <div class="row g-4 mb-4">
                <!-- Enrolled Courses -->
                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="kpi-card">
                        <div class="kpi-label">Enrolled Courses</div>
                        <div class="kpi-number">@enrolledCoursesCount</div>
                        <div class="kpi-footer text-secondary">
                            Active enrollments
                        </div>
                    </div>
                </div>

                <!-- Enrolled Credits -->
                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="kpi-card">
                        <div class="kpi-label">Enrolled Credits</div>
                        <div class="kpi-number">@enrolledCreditsCount</div>
                        <div class="kpi-footer text-secondary">
                            Semester total
                        </div>
                    </div>
                </div>

                <!-- Current GPA -->
                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="kpi-card">
                        <div class="kpi-label">Cumulative GPA</div>
                        <div class="kpi-number">@gpa.ToString("0.00")</div>
                        <div class="kpi-footer text-secondary">
                            Out of 4.00
                        </div>
                    </div>
                </div>

                <!-- Overall Attendance -->
                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="kpi-card">
                        <div class="kpi-label">Attendance Rate</div>
                        <div class="kpi-number">@attendancePercentage.ToString("0.1")%</div>
                        <div class="kpi-footer text-secondary">
                            Overall presence
                        </div>
                    </div>
                </div>
            </div>

            <!-- Middle My Courses Section with Bar Chart -->
            <h5 class="fw-bold mb-3 mt-4 text-dark font-outfit">Academic Progress</h5>
            <div class="row g-4 mb-4">
                <div class="col-12 col-lg-8">
                    @if (studentCourses.Count > 0)
                    {
                        <div class="row g-3">
                            @foreach (var course in studentCourses)
                            {
                                <div class="col-12 col-md-6">
                                    <div class="course-card-modern h-100 course-card-min-height">
                                        <div>
                                            <div class="course-code-modern">@course.Code</div>
                                            <h6 class="course-title-modern">@course.Title</h6>
                                        </div>
                                        <div>
                                            <div class="course-progress-header">
                                                <span>Attendance Progress</span>
                                                <span>@course.Progress.ToString("0.0")%</span>
                                            </div>
                                            <div class="course-progress-bar-container">
                                                <div class="course-progress-bar-fill" style="width: @course.Progress%;"></div>
                                            </div>
                                            <div class="course-footer-modern">
                                                @course.NextTask
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="dashboard-card p-4 text-center">
                            <p class="text-secondary mb-0">You are not enrolled in any courses.</p>
                        </div>
                    }
                </div>
                <div class="col-12 col-lg-4">
                    <div class="dashboard-card p-4 h-100">
                        <h5 class="fw-bold mb-3 text-dark tracker-title">Progress Tracker (Attendance %)</h5>
                        @if (studentCourses.Count > 0)
                        {
                            <RadzenChart class="student-progress-chart">
                                <RadzenBarSeries Data="@studentCourses" CategoryProperty="Code" ValueProperty="Progress" Title="Attendance %" />
                                <RadzenValueAxis Min="0" Max="100" Step="20" />
                            </RadzenChart>
                        }
                        else
                        {
                            <p class="text-secondary small mb-0">No progress data to display.</p>
                        }
                    </div>
                </div>
            </div>

            <!-- Bottom Recent Grades Section (DataGrid Widget) -->
            <div class="grades-card-modern p-4">
                <div class="grades-card-header mb-3">
                    <h5 class="grades-card-title m-0">Recent Grades</h5>
                    <a href="student/grades" class="grades-card-link text-decoration-none">View all <i class="bi bi-arrow-right"></i></a>
                </div>
                @if (recentGrades.Count > 0)
                {
                    <RadzenDataGrid Data="@recentGrades" TItem="Grade" GridLines="DataGridGridLines.Horizontal">
                        <Columns>
                            <RadzenDataGridColumn TItem="Grade" Property="Course.CourseCode" Title="Course Code" Width="120px" />
                            <RadzenDataGridColumn TItem="Grade" Property="Course.Name" Title="Course Name" />
                            <RadzenDataGridColumn TItem="Grade" Property="TotalMarks" Title="Total Marks" Width="120px" TextAlign="TextAlign.Center" />
                            <RadzenDataGridColumn TItem="Grade" Title="Letter Grade" Width="120px" TextAlign="TextAlign.Center">
                                <Template Context="grade">
                                    <span class="badge-grade-modern @GetGradeClass(grade.LetterGrade ?? "F")">
                                        @(grade.LetterGrade ?? "F")
                                    </span>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="Grade" Title="Date" Width="140px">
                                <Template Context="grade">
                                    @((grade.UpdatedAt ?? grade.EnteredAt).ToLocalTime().ToString("MMM dd, yyyy"))
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                }
                else
                {
                    <p class="text-secondary mb-0">No grade records found.</p>
                }
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <!-- Loader during authentication session check -->
        <div class="d-flex flex-column align-items-center justify-content-center portal-loading-container">
            <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate"
                                       Size="ProgressBarCircularSize.Large" />
            <p class="mt-3 text-secondary fw-semibold">Loading Student Portal...</p>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private Student? currentStudent;
    private string academicYear = string.Empty;
    private int enrolledCoursesCount;
    private int enrolledCreditsCount;
    private double gpa;
    private double attendancePercentage = 100.0;
    private List<CourseProgressItem> studentCourses = new();
    private List<Grade> recentGrades = new();

    protected override async Task OnInitializedAsync()
    {
        academicYear = await SystemSettingService.GetAsync("AcademicYear")
            ?? $"{DateTime.UtcNow.Year}-{DateTime.UtcNow.Year + 1}";

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var username = authState.User.Identity?.Name;

        if (!string.IsNullOrEmpty(username))
        {
            var userIdClaim = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
            if (userIdClaim != null && int.TryParse(userIdClaim.Value, out var userId))
            {
                currentStudent = await StudentService.GetByUserIdAsync(userId);
            }
        }

        if (currentStudent != null)
        {
            var activeEnrollments = currentStudent.Enrollments.Where(e => e.Status == EnrollmentStatus.Active).ToList();
            enrolledCoursesCount = activeEnrollments.Count;
            enrolledCreditsCount = activeEnrollments.Sum(e => e.Course.Credits);
            gpa = await GradeService.CalculateGPAAsync(currentStudent.Id);
            attendancePercentage = await AttendanceService.GetOverallAttendancePercentageAsync(currentStudent.Id);

            var courseAttendance = await AttendanceService.GetAttendancePercentageByCoursesAsync(currentStudent.Id);
            studentCourses = activeEnrollments
                .Select(e => new CourseProgressItem
                {
                    Code = e.Course.CourseCode,
                    Title = e.Course.Name,
                    Progress = courseAttendance.TryGetValue(e.CourseId, out var rate) ? rate : 100.0,
                    NextTask = $"Room: {e.Course.RoomNo} | Schedule: {e.Course.Schedule}"
                })
                .ToList();

            recentGrades = await GradeService.GetByStudentAsync(currentStudent.Id);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated != true)
            {
                Navigation.NavigateTo("/login");
            }
            else
            {
                var role = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
                if (role != "Student")
                {
                    Navigation.NavigateTo("/login");
                }
            }
        }
    }

    private string GetInitials(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "AC";
        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0][0].ToString().ToUpper();
        return (parts[0][0].ToString() + parts[^1][0].ToString()).ToUpper();
    }

    private string GetGradeClass(string grade)
    {
        return grade.Trim().ToUpper() switch
        {
            "A" or "A-" => "badge-grade-a",
            "B+" or "B" or "B-" => "badge-grade-b",
            "C+" or "C" or "C-" => "badge-grade-c",
            _ => "badge-grade-pending"
        };
    }
}

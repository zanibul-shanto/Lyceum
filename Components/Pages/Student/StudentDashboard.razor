@page "/student/dashboard"
@inject UserService UserService
@inject CustomAuthStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Student Dashboard - Lyceum</PageTitle>

<AuthorizeView Roles="Student" Context="authContext">
    <Authorized>
        <div class="w-100">
            <!-- Header Section -->
            <div class="d-flex justify-between align-center mb-6">
                <div>
                    <MudText Typo="Typo.h4" Class="font-weight-bold" Style="font-family: 'Outfit', sans-serif;">Dashboard</MudText>
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Spring 2026</MudText>
                </div>
                <MudPaper Class="d-flex align-center pa-2 border" Elevation="0" Style="background-color: white; border-radius: 8px;">
                    <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Class="mr-3" Style="font-weight: 700; font-family: 'Outfit', sans-serif;">
                        @GetInitials(currentStudent?.FullName ?? "Alex Chen")
                    </MudAvatar>
                    <div>
                        <MudText Typo="Typo.body2" Class="font-weight-bold">@(currentStudent?.FullName ?? "Alex Chen")</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Student</MudText>
                    </div>
                </MudPaper>
            </div>

            <!-- KPI Row -->
            <MudGrid Class="mb-6">
                <MudItem XS="12" SM="6" MD="3">
                    <MudPaper Class="pa-6 border" Elevation="0" Style="background-color: white; height: 100%; border-radius: 12px;">
                        <MudText Typo="Typo.overline" Color="Color.Secondary" Style="font-weight: 700; letter-spacing: 0.06em;">Enrolled Courses</MudText>
                        <MudText Typo="Typo.h3" Class="font-weight-bold my-2" Color="Color.Primary" Style="font-family: 'Outfit', sans-serif;">6</MudText>
                        <div class="d-flex align-center gap-2 mt-2">
                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Class="px-2 font-weight-bold" Style="height: 20px; font-size: 0.72rem; border-radius: 4px;">Spring</MudChip>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">2026</MudText>
                        </div>
                    </MudPaper>
                </MudItem>
                <MudItem XS="12" SM="6" MD="3">
                    <MudPaper Class="pa-6 border" Elevation="0" Style="background-color: white; height: 100%; border-radius: 12px;">
                        <MudText Typo="Typo.overline" Color="Color.Secondary" Style="font-weight: 700; letter-spacing: 0.06em;">Assignments Due</MudText>
                        <MudText Typo="Typo.h3" Class="font-weight-bold my-2" Color="Color.Warning" Style="font-family: 'Outfit', sans-serif;">3</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">This week</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem XS="12" SM="6" MD="3">
                    <MudPaper Class="pa-6 border" Elevation="0" Style="background-color: white; height: 100%; border-radius: 12px;">
                        <MudText Typo="Typo.overline" Color="Color.Secondary" Style="font-weight: 700; letter-spacing: 0.06em;">Current GPA</MudText>
                        <MudText Typo="Typo.h3" Class="font-weight-bold my-2" Color="Color.Success" Style="font-family: 'Outfit', sans-serif;">@(currentStudent?.GPA?.ToString("0.00") ?? "3.70")</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Success" Class="mt-2" Style="font-weight: bold;">&uarr; <span style="color: var(--mud-palette-text-secondary); font-weight: normal;">from last term</span></MudText>
                    </MudPaper>
                </MudItem>
                <MudItem XS="12" SM="6" MD="3">
                    <MudPaper Class="pa-6 border" Elevation="0" Style="background-color: white; height: 100%; border-radius: 12px;">
                        <MudText Typo="Typo.overline" Color="Color.Secondary" Style="font-weight: 700; letter-spacing: 0.06em;">Credits Earned</MudText>
                        <MudText Typo="Typo.h3" Class="font-weight-bold my-2" Color="Color.Secondary" Style="font-family: 'Outfit', sans-serif;">42</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">of 120 required</MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            <!-- My Courses -->
            <MudText Typo="Typo.h5" Class="font-weight-bold mb-4" Style="font-family: 'Outfit', sans-serif;">My Courses</MudText>
            <MudGrid Class="mb-6">
                @foreach (var course in mockCourses)
                {
                    <MudItem XS="12" MD="4">
                        <MudCard Class="pa-6 border d-flex flex-column justify-space-between" Outlined="true" Style="height: 100%; min-height: 180px; background-color: white; border-radius: 12px;">
                            <div>
                                <MudText Typo="Typo.overline" Color="Color.Secondary" Style="font-weight: 700;">@course.Code</MudText>
                                <MudText Typo="Typo.h6" Class="font-weight-bold text-dark mb-4" Style="font-family: 'Outfit', sans-serif; line-height: 1.2;">@course.Title</MudText>
                            </div>
                            <div>
                                <div class="d-flex justify-between align-center mb-1">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-weight: 600;">Progress</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Primary" Style="font-weight: 700;">@course.Progress%</MudText>
                                </div>
                                <MudProgressLinear Color="Color.Primary" Value="@course.Progress" Class="mb-4" Style="height: 6px; border-radius: 3px;" />
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Next: <b>@course.NextTask</b></MudText>
                            </div>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>

            <!-- Recent Grades -->
            <MudCard Class="border mb-4" Elevation="0" Style="background-color: white; border-radius: 12px;">
                <MudCardHeader Class="pb-2">
                    <CardHeaderContent>
                        <div class="d-flex justify-between align-center">
                            <MudText Typo="Typo.h5" Class="font-weight-bold" Style="font-family: 'Outfit', sans-serif;">Recent Grades</MudText>
                            <MudButton Href="student/grades" Variant="Variant.Text" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ArrowForward" Style="text-transform: none; font-weight: bold;">View all</MudButton>
                        </div>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent Class="pa-0">
                    <MudTable Items="recentGrades" Elevation="0" Class="border-0">
                        <HeaderContent>
                            <MudTh>Course</MudTh>
                            <MudTh>Assignment</MudTh>
                            <MudTh>Score</MudTh>
                            <MudTh>Grade</MudTh>
                            <MudTh>Submitted</MudTh>
                            <MudTh>Status</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Course" Style="font-weight: bold;">@context.Course</MudTd>
                            <MudTd DataLabel="Assignment">@context.Assignment</MudTd>
                            <MudTd DataLabel="Score" Style="font-family: monospace;">@context.Score</MudTd>
                            <MudTd DataLabel="Grade">
                                <MudChip T="string" Size="Size.Small" Color="@GetGradeChipColor(context.Grade)" Variant="Variant.Filled" Style="font-weight: bold; min-width: 32px; border-radius: 4px;">
                                    @context.Grade
                                </MudChip>
                            </MudTd>
                            <MudTd DataLabel="Submitted">@context.Submitted</MudTd>
                            <MudTd DataLabel="Status">
                                <MudChip T="string" Size="Size.Small" Color="@GetStatusChipColor(context.Status)" Variant="Variant.Outlined" Style="text-transform: capitalize; font-weight: bold;">
                                    @context.Status
                                </MudChip>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudCardContent>
            </MudCard>
        </div>
    </Authorized>
    <NotAuthorized>
        <!-- Premium Loader during pre-render session loading -->
        <div class="d-flex flex-column align-center justify-center" style="min-height: 80vh;">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
            <MudText Class="mt-4 text-secondary font-weight-bold">Loading Student Portal...</MudText>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private User? currentStudent;
    private List<MockCourse> mockCourses = new();
    private List<MockGrade> recentGrades = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var username = authState.User.Identity?.Name;

        if (!string.IsNullOrEmpty(username))
        {
            var allUsers = await UserService.GetAllUsersAsync();
            currentStudent = allUsers.FirstOrDefault(u => u.Username.ToLower() == username.ToLower());
        }

        currentStudent ??= new User
        {
            FullName = "Alex Chen",
            GPA = 3.7,
            Role = UserRole.Student
        };

        LoadMockCourses();
        LoadRecentGrades();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated != true)
            {
                Navigation.NavigateTo("/login");
            }
            else
            {
                var role = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
                if (role != "Student")
                {
                    Navigation.NavigateTo("/login");
                }
            }
        }
    }

    private void LoadMockCourses()
    {
        mockCourses = new List<MockCourse>
        {
            new("Intro to Computer Science", "CS 101", 72, "Lab 4 — due May 24"),
            new("Linear Algebra", "MATH 201", 55, "Next: Problem Set 5 — due May 26"),
            new("Technical Writing", "ENG 110", 40, "Next: Essay Draft — due May 28")
        };
    }

    private void LoadRecentGrades()
    {
        recentGrades = new List<MockGrade>
        {
            new("CS 101", "Midterm Exam", "91 / 100", "A", "May 10", "graded"),
            new("MATH 201", "Problem Set 4", "78 / 100", "B+", "May 8", "graded"),
            new("ENG 110", "Essay Draft", "—", "—", "May 15", "pending"),
            new("CS 101", "Lab 3", "88 / 100", "B+", "May 5", "graded"),
            new("PHYS 101", "Quiz 5", "72 / 100", "C+", "May 3", "graded")
        };
    }

    private string GetInitials(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "AC";
        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0][0].ToString().ToUpper();
        return (parts[0][0].ToString() + parts[^1][0].ToString()).ToUpper();
    }

    private Color GetGradeChipColor(string grade)
    {
        return grade.Trim().ToUpper() switch
        {
            "A" or "A-" => Color.Success,
            "B+" or "B" or "B-" => Color.Primary,
            "C+" or "C" or "C-" => Color.Warning,
            _ => Color.Default
        };
    }

    private Color GetStatusChipColor(string status)
    {
        return status.Trim().ToLower() switch
        {
            "graded" => Color.Success,
            "pending" => Color.Warning,
            _ => Color.Default
        };
    }

    public record MockCourse(string Title, string Code, int Progress, string NextTask);
    public record MockGrade(string Course, string Assignment, string Score, string Grade, string Submitted, string Status);
}

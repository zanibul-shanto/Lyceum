@page "/register"
@inject UserService UserService
@inject NavigationManager Navigation

<PageTitle>Register - Lyceum</PageTitle>

<MudCard Class="pa-8 rounded-xl border" Elevation="0" Style="max-width: 480px; width: 100%; background-color: white;">
    <div class="d-flex align-center gap-3 mb-6">
        <div class="d-flex align-center justify-center rounded-lg" style="width: 32px; height: 32px; background-color: var(--mud-palette-primary); color: white; font-weight: 800; font-size: 1.15rem; font-family: 'Outfit', sans-serif;">L</div>
        <MudText Typo="Typo.h6" Class="font-weight-bold text-dark" Style="font-family: 'Outfit', sans-serif;">Lyceum</MudText>
    </div>

    <MudText Typo="Typo.h5" Class="font-weight-bold mb-1" Style="font-family: 'Outfit', sans-serif;">Create your account</MudText>
    <MudText Typo="Typo.body2" Class="mb-6 text-secondary">Join the Lyceum Management System</MudText>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-6 rounded-lg" Elevation="0">
            @errorMessage
        </MudAlert>
    }

    @if (isSuccess)
    {
        <div class="d-flex flex-column align-center text-center">
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Style="font-size: 3rem;" Class="mb-3" />
            <MudText Typo="Typo.h6" Class="font-weight-bold mb-2">Registration Successful!</MudText>
            <MudText Typo="Typo.body2" Class="text-secondary mb-6">Your account has been created. You can now sign in using your credentials.</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Success" Href="/login" FullWidth="true" Class="py-3 rounded-lg font-weight-bold" Style="text-transform: none;">
                Go to Login
            </MudButton>
        </div>
    }
    else
    {
        <EditForm Model="registerModel" OnValidSubmit="HandleRegister" FormName="RegisterForm">
            <DataAnnotationsValidator />

            <div class="mb-4">
                <MudTextField Label="Username" @bind-Value="registerModel.Username" 
                              For="() => registerModel.Username" Variant="Variant.Outlined" 
                              Placeholder="Choose a username" Required="true" Margin="Margin.Dense" />
            </div>

            <div class="mb-4">
                <MudTextField Label="Full Name" @bind-Value="registerModel.FullName" 
                              For="() => registerModel.FullName" Variant="Variant.Outlined" 
                              Placeholder="Enter your full name" Required="true" Margin="Margin.Dense" />
            </div>

            <div class="mb-4">
                <MudTextField Label="Email Address" @bind-Value="registerModel.Email" 
                              For="() => registerModel.Email" Variant="Variant.Outlined" 
                              Placeholder="you@university.edu" Required="true" Margin="Margin.Dense" />
            </div>

            <div class="mb-4">
                <MudSelect T="string" Label="Role" @bind-Value="registerModel.Role" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true">
                    <MudSelectItem Value="@("Student")">Student</MudSelectItem>
                    <MudSelectItem Value="@("Teacher")">Teacher</MudSelectItem>
                    <MudSelectItem Value="@("Admin")">Administrator</MudSelectItem>
                </MudSelect>
            </div>

            <div class="mb-4">
                <MudTextField Label="Password" @bind-Value="registerModel.Password" 
                              For="() => registerModel.Password" Variant="Variant.Outlined" 
                              Placeholder="Choose a password" Required="true" 
                              InputType="InputType.Password" Margin="Margin.Dense" />
            </div>

            <div class="mb-6">
                <MudTextField Label="Confirm Password" @bind-Value="registerModel.ConfirmPassword" 
                              For="() => registerModel.ConfirmPassword" Variant="Variant.Outlined" 
                              Placeholder="Re-enter password" Required="true" 
                              InputType="InputType.Password" Margin="Margin.Dense" />
            </div>

            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" 
                       FullWidth="true" Class="py-3 rounded-lg font-weight-bold" Style="text-transform: none; font-size: 0.95rem;" 
                       Disabled="@isLoading">
                @if (isLoading)
                {
                    <MudProgressCircular Size="Size.Small" Color="Color.Default" Indeterminate="true" Class="mr-2" />
                    <span>Registering...</span>
                }
                else
                {
                    <span>Create Account</span>
                }
            </MudButton>
        </EditForm>

        <div class="d-flex align-center justify-center mt-6">
            <MudText Typo="Typo.body2" Class="text-secondary mr-1">Already have an account?</MudText>
            <MudLink Href="/login" Underline="Underline.Hover" Typo="Typo.body2" Color="Color.Primary" Style="font-weight: 700;">Sign in</MudLink>
        </div>
    }
</MudCard>

@code {
    private RegisterViewModel registerModel = new();
    private string? errorMessage;
    private bool isLoading;
    private bool isSuccess;

    private async Task HandleRegister()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            if (registerModel.Password != registerModel.ConfirmPassword)
            {
                errorMessage = "Passwords do not match.";
                return;
            }

            var newUser = new User
            {
                Username = registerModel.Username,
                FullName = registerModel.FullName,
                Email = registerModel.Email,
                Role = Enum.Parse<UserRole>(registerModel.Role)
            };

            await UserService.RegisterAsync(newUser, registerModel.Password);
            isSuccess = true;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    public class RegisterViewModel
    {
        [Required(ErrorMessage = "Username is required")]
        [StringLength(50, MinimumLength = 3, ErrorMessage = "Username must be between 3 and 50 characters")]
        public string Username { get; set; } = string.Empty;

        [Required(ErrorMessage = "Full Name is required")]
        [StringLength(100, ErrorMessage = "Full name cannot exceed 100 characters")]
        public string FullName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Email is required")]
        [EmailAddress(ErrorMessage = "Invalid email address")]
        public string Email { get; set; } = string.Empty;

        [Required]
        public string Role { get; set; } = "Student";

        [Required(ErrorMessage = "Password is required")]
        [StringLength(100, MinimumLength = 6, ErrorMessage = "Password must be at least 6 characters")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Confirm Password is required")]
        [Compare("Password", ErrorMessage = "Passwords do not match")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}

@page "/admin/courses"
@inject CourseService CourseService
@inject UserService UserService
@inject CustomAuthStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Course Management - Lyceum</PageTitle>

<AuthorizeView Roles="Admin" Context="authContext">
    <Authorized>
        <div class="w-100">
            <!-- Header Section -->
            <div class="d-flex justify-between align-center mb-6">
                <div>
                    <MudText Typo="Typo.h4" Class="font-weight-bold mb-1" Style="font-family: 'Outfit', sans-serif;">Course Management</MudText>
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Create, schedule, and manage courses across all departments.</MudText>
                </div>
                <MudButton OnClick="ShowAddModal" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.LibraryAdd" Class="py-2 px-4 font-weight-bold" Style="text-transform: none; border-radius: 8px;">
                    Add Course
                </MudButton>
            </div>

            <!-- KPI Row -->
            <MudGrid Class="mb-6">
                <MudItem XS="12" SM="6" MD="3">
                    <MudPaper Class="pa-6 border d-flex align-center gap-4" Elevation="0" Style="background-color: white; border-radius: 12px; height: 100%;">
                        <div class="d-flex align-center justify-center rounded-lg" style="width: 48px; height: 48px; background-color: var(--mud-palette-primary-lighten); color: var(--mud-palette-primary);">
                            <MudIcon Icon="@Icons.Material.Filled.Book" />
                        </div>
                        <div>
                            <MudText Typo="Typo.overline" Color="Color.Secondary" Style="font-weight: 700;">Total Courses</MudText>
                            <MudText Typo="Typo.h4" Class="font-weight-bold" Style="font-family: 'Outfit', sans-serif;">@allCourses.Count</MudText>
                        </div>
                    </MudPaper>
                </MudItem>
                <MudItem XS="12" SM="6" MD="3">
                    <MudPaper Class="pa-6 border d-flex align-center gap-4" Elevation="0" Style="background-color: white; border-radius: 12px; height: 100%;">
                        <div class="d-flex align-center justify-center rounded-lg" style="width: 48px; height: 48px; background-color: var(--mud-palette-success-lighten); color: var(--mud-palette-success);">
                            <MudIcon Icon="@Icons.Material.Filled.ToggleOn" />
                        </div>
                        <div>
                            <MudText Typo="Typo.overline" Color="Color.Secondary" Style="font-weight: 700;">Active</MudText>
                            <MudText Typo="Typo.h4" Class="font-weight-bold" Style="font-family: 'Outfit', sans-serif;">@allCourses.Count(c => c.IsActive)</MudText>
                        </div>
                    </MudPaper>
                </MudItem>
                <MudItem XS="12" SM="6" MD="3">
                    <MudPaper Class="pa-6 border d-flex align-center gap-4" Elevation="0" Style="background-color: white; border-radius: 12px; height: 100%;">
                        <div class="d-flex align-center justify-center rounded-lg" style="width: 48px; height: 48px; background-color: var(--mud-palette-background-grey); color: var(--mud-palette-text-secondary);">
                            <MudIcon Icon="@Icons.Material.Filled.ToggleOff" />
                        </div>
                        <div>
                            <MudText Typo="Typo.overline" Color="Color.Secondary" Style="font-weight: 700;">Inactive</MudText>
                            <MudText Typo="Typo.h4" Class="font-weight-bold" Style="font-family: 'Outfit', sans-serif;">@allCourses.Count(c => !c.IsActive)</MudText>
                        </div>
                    </MudPaper>
                </MudItem>
                <MudItem XS="12" SM="6" MD="3">
                    <MudPaper Class="pa-6 border d-flex align-center gap-4" Elevation="0" Style="background-color: white; border-radius: 12px; height: 100%;">
                        <div class="d-flex align-center justify-center rounded-lg" style="width: 48px; height: 48px; background-color: var(--mud-palette-warning-lighten); color: var(--mud-palette-warning);">
                            <MudIcon Icon="@Icons.Material.Filled.SupervisorAccount" />
                        </div>
                        <div>
                            <MudText Typo="Typo.overline" Color="Color.Secondary" Style="font-weight: 700;">Teachers Assigned</MudText>
                            <MudText Typo="Typo.h4" Class="font-weight-bold" Style="font-family: 'Outfit', sans-serif;">@allCourses.SelectMany(c => c.CourseTeachers).Select(ct => ct.TeacherId).Distinct().Count()</MudText>
                        </div>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            <!-- Course Directory Table -->
            <MudCard Class="border mb-4" Elevation="0" Style="background-color: white; border-radius: 12px;">
                <MudCardHeader Class="pb-2">
                    <CardHeaderContent>
                        <div class="d-flex flex-column flex-md-row justify-between align-start align-md-center gap-4">
                            <MudText Typo="Typo.h5" Class="font-weight-bold" Style="font-family: 'Outfit', sans-serif;">Course Directory</MudText>
                            
                            <div class="d-flex flex-wrap gap-3 align-center" style="min-width: 320px;">
                                <!-- Search Input -->
                                <MudTextField @bind-Value="searchTerm" Placeholder="Search by name or code..." 
                                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" 
                                              Variant="Variant.Outlined" Margin="Margin.Dense" Class="bg-white rounded-lg" Immediate="true" />
                                
                                <!-- Status Filter Select -->
                                <MudSelect T="string" @bind-Value="statusFilter" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 150px;">
                                    <MudSelectItem Value="@("All")">All Status</MudSelectItem>
                                    <MudSelectItem Value="@("Active")">Active</MudSelectItem>
                                    <MudSelectItem Value="@("Inactive")">Inactive</MudSelectItem>
                                </MudSelect>
                            </div>
                        </div>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent Class="pa-0">
                    <MudTable Items="filteredCourses" Elevation="0" Class="border-0" Hover="true" RowsPerPage="10">
                        <HeaderContent>
                            <MudTh>Active</MudTh>
                            <MudTh>Code</MudTh>
                            <MudTh>Name</MudTh>
                            <MudTh>Schedule / Room</MudTh>
                            <MudTh>Credits</MudTh>
                            <MudTh>Capacity</MudTh>
                            <MudTh>Teachers</MudTh>
                            <MudTh>Created</MudTh>
                            <MudTh Style="text-align: right;">Actions</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Active">
                                <MudSwitch T="bool" Value="@context.IsActive" ValueChanged="() => ToggleActive(context)" Color="Color.Primary" />
                            </MudTd>
                            <MudTd DataLabel="Code">
                                <span class="font-monospace fw-semibold text-primary">@context.CourseCode</span>
                            </MudTd>
                            <MudTd DataLabel="Name">
                                <MudText Typo="Typo.body2" Class="font-weight-bold">@context.Name</MudText>
                                @if (!string.IsNullOrWhiteSpace(context.Description))
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block" Style="max-width:240px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                                        @context.Description
                                    </MudText>
                                }
                            </MudTd>
                            <MudTd DataLabel="Schedule / Room">
                                <MudText Typo="Typo.body2">@(string.IsNullOrWhiteSpace(context.Schedule) ? "—" : context.Schedule)</MudText>
                                @if (!string.IsNullOrWhiteSpace(context.RoomNo))
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@context.RoomNo</MudText>
                                }
                            </MudTd>
                            <MudTd DataLabel="Credits">
                                <MudChip T="string" Color="Color.Success" Variant="Variant.Text" Size="Size.Small" Style="font-weight: bold; border-radius: 4px;">
                                    @context.Credits cr
                                </MudChip>
                            </MudTd>
                            <MudTd DataLabel="Capacity">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">@context.MaxCapacity</MudText>
                            </MudTd>
                            <MudTd DataLabel="Teachers">
                                @if (!context.CourseTeachers.Any())
                                {
                                    <span style="color: var(--mud-palette-text-disabled);">—</span>
                                }
                                else
                                {
                                    <div class="d-flex flex-wrap gap-1" style="max-width: 200px;">
                                        @foreach (var ct in context.CourseTeachers.Take(2))
                                        {
                                            <MudChip T="string" Color="Color.Warning" Size="Size.Small" Style="font-size: 0.72rem; height: 20px; font-weight: bold; border-radius: 4px;" Class="ma-0">
                                                @ct.Teacher.FullName
                                            </MudChip>
                                        }
                                        @if (context.CourseTeachers.Count > 2)
                                        {
                                            <MudChip T="string" Color="Color.Default" Size="Size.Small" Style="font-size: 0.72rem; height: 20px; font-weight: bold; border-radius: 4px;" Class="ma-0">
                                                +@(context.CourseTeachers.Count - 2)
                                            </MudChip>
                                        }
                                    </div>
                                }
                            </MudTd>
                            <MudTd DataLabel="Created">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">@context.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")</MudText>
                            </MudTd>
                            <MudTd DataLabel="Actions" Style="text-align: right;">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" OnClick="() => ShowEditModal(context)" Size="Size.Small" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="() => ConfirmDelete(context)" Size="Size.Small" />
                            </MudTd>
                        </RowTemplate>
                        <PagerContent>
                            <MudTablePager />
                        </PagerContent>
                        <NoRecordsContent>
                            <div class="text-center py-6 text-secondary">
                                <MudIcon Icon="@Icons.Material.Filled.LibraryBooks" Style="font-size: 2.5rem;" Color="Color.Default" Class="mb-2" />
                                <MudText Typo="Typo.body2" Style="font-weight: bold;">No courses found matching current filters.</MudText>
                            </div>
                        </NoRecordsContent>
                    </MudTable>
                </MudCardContent>
            </MudCard>

            <!-- Modal: Add / Edit Course -->
            <MudDialog @bind-Visible="isCourseModalVisible" Options="_courseDialogOptions">
                <TitleContent>
                    <MudText Typo="Typo.h6" Class="font-weight-bold" Style="font-family: 'Outfit', sans-serif;">
                        @(editingCourse.Id == 0 ? "Add New Course" : "Edit Course")
                    </MudText>
                </TitleContent>
                <DialogContent>
                    @if (!string.IsNullOrEmpty(modalError))
                    {
                        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4 rounded-lg" Elevation="0">
                            @modalError
                        </MudAlert>
                    }

                    <EditForm Model="editingCourse" OnValidSubmit="SaveCourse" FormName="CourseForm">
                        <DataAnnotationsValidator />

                        <MudGrid Class="g-3">
                            <MudItem XS="12" SM="8">
                                <MudTextField Label="Course Name" @bind-Value="editingCourse.Name" 
                                              For="() => editingCourse.Name" Variant="Variant.Outlined" 
                                              Placeholder="e.g. Introduction to Computer Science" Margin="Margin.Dense" Required="true" />
                            </MudItem>
                            <MudItem XS="12" SM="4">
                                <MudTextField Label="Course Code" @bind-Value="editingCourse.CourseCode" 
                                              For="() => editingCourse.CourseCode" Variant="Variant.Outlined" 
                                              Placeholder="e.g. CS101" Margin="Margin.Dense" Required="true" />
                            </MudItem>

                            <MudItem XS="12">
                                <MudTextField Label="Description" @bind-Value="editingCourse.Description" Lines="2"
                                              Variant="Variant.Outlined" Placeholder="Brief course description..." Margin="Margin.Dense" />
                            </MudItem>

                            <MudItem XS="12" SM="6">
                                <MudTextField Label="Schedule" @bind-Value="editingCourse.Schedule" 
                                              Variant="Variant.Outlined" Placeholder="e.g. Mon/Wed 9:00–10:30 AM" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem XS="12" SM="6">
                                <MudTextField Label="Room No." @bind-Value="editingCourse.RoomNo" 
                                              Variant="Variant.Outlined" Placeholder="e.g. Science Hall, Rm 302" Margin="Margin.Dense" />
                            </MudItem>

                            <MudItem XS="6" SM="3">
                                <MudNumericField T="int" Label="Credits" @bind-Value="editingCourse.Credits" 
                                                 For="() => editingCourse.Credits" Min="1" Max="10" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" />
                            </MudItem>
                            <MudItem XS="6" SM="3">
                                <MudNumericField T="int" Label="Max Capacity" @bind-Value="editingCourse.MaxCapacity" 
                                                 For="() => editingCourse.MaxCapacity" Min="1" Max="500" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" />
                            </MudItem>
                            <MudItem XS="12" SM="6" Class="d-flex align-center pb-2">
                                <MudSwitch T="bool" @bind-Value="editingCourse.IsActive" Label="Course is Active" Color="Color.Primary" />
                            </MudItem>

                            <!-- Teacher Assignment -->
                            <MudItem XS="12">
                                @if (!allTeachers.Any())
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">No teachers found. Add teacher accounts first.</MudText>
                                }
                                else
                                {
                                    <MudSelect T="string" Label="Assign Teachers" MultiSelection="true" @bind-SelectedValues="selectedTeacherNamesEnumerable" Variant="Variant.Outlined" Margin="Margin.Dense" Class="bg-white">
                                        @foreach (var tOption in teacherOptions)
                                        {
                                            <MudSelectItem Value="@tOption">@tOption</MudSelectItem>
                                        }
                                    </MudSelect>
                                }
                            </MudItem>
                        </MudGrid>

                        <div class="d-flex justify-end gap-3 mt-6">
                            <MudButton OnClick="CloseModal" Variant="Variant.Text" Color="Color.Secondary" Style="text-transform: none; font-weight: bold;">Cancel</MudButton>
                            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" Style="text-transform: none; font-weight: bold; border-radius: 8px;">Save Course</MudButton>
                        </div>
                    </EditForm>
                </DialogContent>
            </MudDialog>

            <!-- Modal: Delete Confirmation -->
            <MudDialog @bind-Visible="isDeleteModalVisible" Options="_deleteDialogOptions">
                <TitleContent>
                    <MudText Typo="Typo.h6" Class="font-weight-bold" Style="font-family: 'Outfit', sans-serif;">Confirm Deletion</MudText>
                </TitleContent>
                <DialogContent>
                    <div class="text-center py-4">
                        <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error" Style="font-size: 3rem;" Class="mb-3" />
                        <MudText Typo="Typo.h6" Class="font-weight-bold mb-2">Delete Course?</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="px-4">
                            Are you sure you want to delete <strong>@courseToDelete?.Name</strong> (<span class="font-monospace">@courseToDelete?.CourseCode</span>)?
                            This action cannot be undone.
                        </MudText>
                    </div>
                </DialogContent>
                <DialogActions>
                    <div class="d-flex justify-center gap-3 w-100 pb-4">
                        <MudButton OnClick="CloseDeleteModal" Variant="Variant.Text" Color="Color.Secondary" Style="text-transform: none; font-weight: bold; width: 120px;">Cancel</MudButton>
                        <MudButton OnClick="DeleteCourse" Variant="Variant.Filled" Color="Color.Error" Style="text-transform: none; font-weight: bold; border-radius: 8px; width: 160px;">Delete Permanently</MudButton>
                    </div>
                </DialogActions>
            </MudDialog>
        </div>
    </Authorized>
    <NotAuthorized>
        <!-- Premium Loader during pre-render session loading -->
        <div class="d-flex flex-column align-center justify-center" style="min-height: 80vh;">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
            <MudText Class="mt-4 text-secondary font-weight-bold">Loading Admin Portal...</MudText>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private List<Course> allCourses = [];
    private List<Course> filteredCourses = [];
    private List<User> allTeachers = [];

    // Custom getter/setter binds to easily react to search and filter inputs
    private string _searchTerm = string.Empty;
    private string searchTerm
    {
        get => _searchTerm;
        set
        {
            if (_searchTerm != value)
            {
                _searchTerm = value;
                ApplyFilters();
            }
        }
    }

    private string _statusFilter = "All";
    private string statusFilter
    {
        get => _statusFilter;
        set
        {
            if (_statusFilter != value)
            {
                _statusFilter = value;
                ApplyFilters();
            }
        }
    }

    // Modal state
    private bool isCourseModalVisible;
    private bool isDeleteModalVisible;
    private Course editingCourse = new();
    private Course? courseToDelete;
    private string? modalError;
    private HashSet<string> selectedTeacherNames = new();

    // Map selected values for MudSelect multi-selection enumerable
    private IEnumerable<string> selectedTeacherNamesEnumerable
    {
        get => selectedTeacherNames;
        set => selectedTeacherNames = value.ToHashSet();
    }

    private readonly DialogOptions _courseDialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
    private readonly DialogOptions _deleteDialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };

    private List<string> teacherOptions =>
        allTeachers.Select(TeacherLabel).ToList();

    private Dictionary<string, int> teacherNameToId =>
        allTeachers.ToDictionary(TeacherLabel, t => t.Id);

    private static string TeacherLabel(User t) =>
        t.FullName + (string.IsNullOrWhiteSpace(t.Department) ? "" : $" ({t.Department})");

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated != true)
            {
                Navigation.NavigateTo("/login");
                return;
            }
            var role = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
            if (role != "Admin")
                Navigation.NavigateTo("/login");
        }
    }

    private async Task LoadDataAsync()
    {
        allCourses = await CourseService.GetAllAsync();
        allTeachers = await UserService.GetUsersByRoleAsync(UserRole.Teacher);
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        var result = allCourses.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var q = searchTerm.Trim().ToLower();
            result = result.Where(c =>
                c.Name.ToLower().Contains(q) ||
                c.CourseCode.ToLower().Contains(q));
        }

        if (statusFilter == "Active")
            result = result.Where(c => c.IsActive);
        else if (statusFilter == "Inactive")
            result = result.Where(c => !c.IsActive);

        filteredCourses = result.ToList();
        StateHasChanged();
    }

    private void ShowAddModal()
    {
        editingCourse = new Course { IsActive = true, Credits = 3, MaxCapacity = 30 };
        selectedTeacherNames = new();
        modalError = null;
        isCourseModalVisible = true;
    }

    private void ShowEditModal(Course course)
    {
        editingCourse = new Course
        {
            Id = course.Id,
            Name = course.Name,
            CourseCode = course.CourseCode,
            Description = course.Description,
            Schedule = course.Schedule,
            RoomNo = course.RoomNo,
            Credits = course.Credits,
            MaxCapacity = course.MaxCapacity,
            IsActive = course.IsActive,
            CreatedAt = course.CreatedAt
        };
        selectedTeacherNames = course.CourseTeachers
            .Select(ct => TeacherLabel(ct.Teacher))
            .ToHashSet();
        modalError = null;
        isCourseModalVisible = true;
    }

    private void CloseModal()
    {
        isCourseModalVisible = false;
        editingCourse = new();
        selectedTeacherNames = new();
    }

    private async Task SaveCourse()
    {
        modalError = null;
        try
        {
            var teacherIds = selectedTeacherNames
                .Where(n => teacherNameToId.ContainsKey(n))
                .Select(n => teacherNameToId[n])
                .ToList();

            if (editingCourse.Id == 0)
                await CourseService.CreateAsync(editingCourse, teacherIds);
            else
                await CourseService.UpdateAsync(editingCourse, teacherIds);

            CloseModal();
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            modalError = ex.Message;
        }
    }

    private async Task ToggleActive(Course course)
    {
        await CourseService.ToggleActiveAsync(course.Id);
        course.IsActive = !course.IsActive;
        ApplyFilters();
    }

    private void ConfirmDelete(Course course)
    {
        courseToDelete = course;
        isDeleteModalVisible = true;
    }

    private void CloseDeleteModal()
    {
        isDeleteModalVisible = false;
        courseToDelete = null;
    }

    private async Task DeleteCourse()
    {
        if (courseToDelete != null)
        {
            try
            {
                await CourseService.DeleteAsync(courseToDelete.Id);
                CloseDeleteModal();
                await LoadDataAsync();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error deleting course: {ex.Message}");
                CloseDeleteModal();
            }
        }
    }
}

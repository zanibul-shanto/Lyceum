@page "/admin/courses"
@inject CourseService CourseService
@inject UserService UserService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject NotificationService NotificationService
@inject DialogService DialogService

<PageTitle>Course Management - Lyceum</PageTitle>

<AuthorizeView Roles="Admin" Context="authContext">
    <Authorized>
        <div class="container-fluid py-4 px-xl-5">
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="fw-bold mb-1 page-title-modern">Course Management</h1>
                    <p class="page-subtitle-modern">Create, schedule, and manage courses across all departments.</p>
                </div>
                <RadzenButton Text="Add Course" Icon="add_circle" Click="ShowAddModal"
                              ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Medium" />
            </div>

            <!-- KPI Cards -->
            <div class="row g-4 mb-5">
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="dashboard-card">
                        <div class="kpi-label">Total Courses</div>
                        <div class="kpi-number">@allCourses.Count</div>
                    </div>
                </div>
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="dashboard-card">
                        <div class="kpi-label">Active</div>
                        <div class="kpi-number kpi-active">@allCourses.Count(c => c.IsActive)</div>
                    </div>
                </div>
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="dashboard-card">
                        <div class="kpi-label">Inactive</div>
                        <div class="kpi-number kpi-inactive">@allCourses.Count(c => !c.IsActive)</div>
                    </div>
                </div>
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="dashboard-card">
                        <div class="kpi-label">Subjects Total</div>
                        <div class="kpi-number">@allCourses.Sum(c => c.Subjects.Count)</div>
                    </div>
                </div>
            </div>

            <!-- Course Grid -->
            <div class="dashboard-card p-4 mb-4">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
                    <h4 class="fw-bold mb-0 page-title-modern">Course Directory</h4>

                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <RadzenTextBox @bind-Value="searchTerm" Placeholder="Search by name or code..."
                                       Change="@(_ => ApplyFilters())" class="search-textbox" />
                        <RadzenDropDown Data="@statusOptions" @bind-Value="statusFilter"
                                       Change="@(_ => ApplyFilters())" class="role-dropdown" />
                    </div>
                </div>

                <RadzenDataGrid Data="@filteredCourses" TItem="Course" AllowSorting="true" AllowPaging="true"
                                PageSize="10" GridLines="DataGridGridLines.Horizontal">
                    <Columns>
                        <RadzenDataGridColumn TItem="Course" Title="Active" Width="80px" Sortable="false" TextAlign="TextAlign.Center">
                            <Template Context="course">
                                <div class="form-check form-switch mb-0 d-flex justify-content-center">
                                    <input class="form-check-input" type="checkbox" role="switch"
                                           checked="@course.IsActive" @onchange="() => ToggleActive(course)"
                                           title="@(course.IsActive ? "Deactivate" : "Activate")" />
                                </div>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="Course" Property="CourseCode" Title="Code" Width="110px">
                            <Template Context="course">
                                <span class="font-monospace fw-semibold text-primary">@course.CourseCode</span>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="Course" Property="Name" Title="Name">
                            <Template Context="course">
                                <div class="fw-bold text-dark">@course.Name</div>
                                @if (!string.IsNullOrWhiteSpace(course.Description))
                                {
                                    <div class="text-secondary small course-desc-truncate">
                                        @course.Description
                                    </div>
                                }
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="Course" Property="Credits" Title="Credits" Width="90px" TextAlign="TextAlign.Center">
                            <Template Context="course">
                                <span class="badge bg-success-subtle text-success fw-normal">@course.Credits cr</span>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="Course" Property="MaxCapacity" Title="Cap." Width="80px" TextAlign="TextAlign.Center">
                            <Template Context="course">
                                <span class="text-secondary small">@course.MaxCapacity</span>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="Course" Property="CreatedAt" Title="Created" Width="130px">
                            <Template Context="course">
                                <span class="text-secondary small">@course.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")</span>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="Course" Title="" Width="155px" Sortable="false" TextAlign="TextAlign.End">
                            <Template Context="course">
                                <RadzenButton Icon="people" Click="@(() => ShowEnrollmentModal(course))"
                                              ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small" class="me-1" title="Manage Enrollments" />
                                <RadzenButton Icon="edit" Click="@(() => ShowEditModal(course))"
                                              ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" class="me-1" />
                                <RadzenButton Icon="delete" Click="@(() => ConfirmDelete(course))"
                                              ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" />
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="d-flex flex-column align-items-center justify-content-center portal-loading-container">
            <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate"
                                       Size="ProgressBarCircularSize.Large" />
            <p class="mt-3 text-secondary fw-semibold">Loading Admin Portal...</p>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private List<Course> allCourses = [];
    private List<Course> filteredCourses = [];

    private string searchTerm = string.Empty;
    private string statusFilter = "All";
    private readonly List<string> statusOptions = ["All", "Active", "Inactive"];

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated != true)
            {
                Navigation.NavigateTo("/login");
                return;
            }
            var role = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
            if (role != "Admin")
                Navigation.NavigateTo("/login");
        }
    }

    private async Task LoadDataAsync()
    {
        allCourses = await CourseService.GetAllAsync();
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        var result = allCourses.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var q = searchTerm.Trim().ToLower();
            result = result.Where(c =>
                c.Name.ToLower().Contains(q) ||
                c.CourseCode.ToLower().Contains(q));
        }

        if (statusFilter == "Active")
            result = result.Where(c => c.IsActive);
        else if (statusFilter == "Inactive")
            result = result.Where(c => !c.IsActive);

        filteredCourses = result.ToList();
    }

    private async Task ShowEnrollmentModal(Course course)
    {
        await DialogService.OpenAsync<EnrollmentDialog>($"Manage Enrollments — {course.Name}",
            new Dictionary<string, object?> { { "CourseId", course.Id } },
            new DialogOptions { Width = "720px", Resizable = false, CloseDialogOnOverlayClick = true });

        await LoadDataAsync();
    }

    private async Task ShowAddModal()
    {
        var course = new Course { IsActive = true, Credits = 3, MaxCapacity = 30 };
        var result = await DialogService.OpenAsync<CourseDialog>("Add New Course",
            new Dictionary<string, object?>
            {
                { "Course", course }
            },
            new DialogOptions { Width = "680px", Resizable = false, CloseDialogOnOverlayClick = true });

        if (result == true)
        {
            await LoadDataAsync();
        }
    }

    private async Task ShowEditModal(Course course)
    {
        var courseClone = new Course
        {
            Id = course.Id,
            Name = course.Name,
            CourseCode = course.CourseCode,
            Description = course.Description,
            Credits = course.Credits,
            MaxCapacity = course.MaxCapacity,
            IsActive = course.IsActive,
            CreatedAt = course.CreatedAt
        };

        var result = await DialogService.OpenAsync<CourseDialog>("Edit Course",
            new Dictionary<string, object?>
            {
                { "Course", courseClone }
            },
            new DialogOptions { Width = "680px", Resizable = false, CloseDialogOnOverlayClick = true });

        if (result == true)
        {
            await LoadDataAsync();
        }
    }

    private async Task ToggleActive(Course course)
    {
        await CourseService.ToggleActiveAsync(course.Id);
        course.IsActive = !course.IsActive;
        ApplyFilters();
    }

    private async Task ConfirmDelete(Course course)
    {
        var confirm = await DialogService.Confirm(
            $"Are you sure you want to delete {course.Name} ({course.CourseCode})? This action cannot be undone.",
            "Delete Course",
            new ConfirmOptions { OkButtonText = "Delete Permanently", CancelButtonText = "Cancel" });

        if (confirm == true)
        {
            try
            {
                await CourseService.DeleteAsync(course.Id);
                await LoadDataAsync();
                NotificationService.Notify(NotificationSeverity.Warning, "Deleted", "Course has been removed.");
            }
            catch (Exception ex)
            {
                NotificationService.Notify(NotificationSeverity.Error, "Error", $"Could not delete course: {ex.Message}");
            }
        }
    }
}

@inject SubjectService SubjectService
@inject DialogService DialogService
@inject NotificationService NotificationService

<div class="p-3">
    @if (!string.IsNullOrEmpty(modalError))
    {
        <div class="alert alert-danger border-0 mb-3 alert-custom">@modalError</div>
    }

    <EditForm Model="Subject" OnValidSubmit="SaveSubject" FormName="SubjectDialogForm">
        <DataAnnotationsValidator />

        <div class="row g-3">
            <div class="col-12 col-md-4">
                <label class="form-label fw-semibold small text-secondary">Subject Code</label>
                <InputText @bind-Value="Subject.SubjectCode" class="form-control form-control-custom"
                           placeholder="e.g. CS101-A" />
                <ValidationMessage For="() => Subject.SubjectCode" />
            </div>

            <div class="col-12 col-md-8">
                <label class="form-label fw-semibold small text-secondary">Subject Name</label>
                <InputText @bind-Value="Subject.SubjectName" class="form-control form-control-custom"
                           placeholder="e.g. Programming Fundamentals" />
                <ValidationMessage For="() => Subject.SubjectName" />
            </div>

            <div class="col-12">
                <label class="form-label fw-semibold small text-secondary">Description</label>
                <InputTextArea @bind-Value="Subject.Description" class="form-control form-control-custom"
                               rows="3" placeholder="Brief subject description..." />
                <ValidationMessage For="() => Subject.Description" />
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">
            <RadzenButton Text="Cancel" Click="@(() => DialogService.Close(false))" ButtonStyle="ButtonStyle.Light" />
            <RadzenButton ButtonType="ButtonType.Submit" Text="Save Subject" Icon="save" ButtonStyle="ButtonStyle.Primary" />
        </div>
    </EditForm>
</div>

@code {
    [Parameter] public int CourseId { get; set; }
    [Parameter] public Subject Subject { get; set; } = new();

    private string? modalError;

    protected override void OnInitialized()
    {
        if (Subject == null)
        {
            Subject = new Subject();
        }
        if (Subject.Id == 0)
        {
            Subject.CourseId = CourseId;
        }
    }

    private async Task SaveSubject()
    {
        modalError = null;
        try
        {
            if (Subject.Id == 0)
            {
                await SubjectService.CreateAsync(Subject);
                NotificationService.Notify(NotificationSeverity.Success, "Created", "Subject created successfully.");
            }
            else
            {
                await SubjectService.UpdateAsync(Subject);
                NotificationService.Notify(NotificationSeverity.Success, "Saved", "Subject updated successfully.");
            }

            DialogService.Close(true);
        }
        catch (Exception ex)
        {
            modalError = ex.Message;
        }
    }
}

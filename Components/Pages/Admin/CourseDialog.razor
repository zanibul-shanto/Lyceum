@inject CourseService CourseService
@inject DialogService DialogService
@inject NotificationService NotificationService

<div class="p-3">
    @if (!string.IsNullOrEmpty(modalError))
    {
        <div class="alert alert-danger border-0 mb-3 alert-custom">@modalError</div>
    }

    <EditForm Model="Course" OnValidSubmit="SaveCourse" FormName="CourseDialogForm">
        <DataAnnotationsValidator />

        <div class="row g-3">
            <div class="col-12 col-md-8">
                <label class="form-label fw-semibold small text-secondary">Course Name</label>
                <InputText @bind-Value="Course.Name" class="form-control form-control-custom"
                           placeholder="e.g. Introduction to Computer Science" />
                <ValidationMessage For="() => Course.Name" />
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label fw-semibold small text-secondary">Course Code</label>
                <InputText @bind-Value="Course.CourseCode" class="form-control form-control-custom"
                           placeholder="e.g. CS101" />
                <ValidationMessage For="() => Course.CourseCode" />
            </div>

            <div class="col-12">
                <label class="form-label fw-semibold small text-secondary">Description</label>
                <InputTextArea @bind-Value="Course.Description" class="form-control form-control-custom"
                               rows="2" placeholder="Brief course description..." />
            </div>

            <div class="col-6 col-md-3">
                <label class="form-label fw-semibold small text-secondary">Credits</label>
                <InputNumber @bind-Value="Course.Credits" class="form-control form-control-custom"
                             min="1" max="10" />
                <ValidationMessage For="() => Course.Credits" />
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label fw-semibold small text-secondary">Max Capacity</label>
                <InputNumber @bind-Value="Course.MaxCapacity" class="form-control form-control-custom"
                             min="1" max="500" />
                <ValidationMessage For="() => Course.MaxCapacity" />
            </div>
            <div class="col-12 col-md-6 d-flex align-items-end pb-1">
                <div class="form-check form-switch">
                    <InputCheckbox @bind-Value="Course.IsActive" class="form-check-input" id="isActiveCb" />
                    <label class="form-check-label fw-semibold small text-secondary" for="isActiveCb">Course is Active</label>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">
            <RadzenButton Text="Cancel" Click="@(() => DialogService.Close(false))" ButtonStyle="ButtonStyle.Light" />
            <RadzenButton ButtonType="ButtonType.Submit" Text="Save Course" Icon="save" ButtonStyle="ButtonStyle.Primary" />
        </div>
    </EditForm>
</div>

@code {
    [Parameter] public Course Course { get; set; } = new();

    private string? modalError;

    private async Task SaveCourse()
    {
        modalError = null;
        try
        {
            if (Course.Id == 0)
                await CourseService.CreateAsync(Course);
            else
                await CourseService.UpdateAsync(Course);

            DialogService.Close(true);
            NotificationService.Notify(NotificationSeverity.Success, "Saved", "Course saved successfully.");
        }
        catch (Exception ex)
        {
            modalError = ex.Message;
        }
    }
}

@page "/admin/teachers"
@inject TeacherService TeacherService
@inject UserService UserService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject NotificationService NotificationService
@inject DialogService DialogService

<PageTitle>Teacher Management - Lyceum</PageTitle>

<AuthorizeView Roles="Admin" Context="authContext">
    <Authorized>
        <div class="container-fluid py-4 px-xl-5">
            <!-- Header Section -->
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
                <div>
                    <h1 class="fw-bold mb-1 page-title-modern">Teacher Management</h1>
                    <p class="page-subtitle-modern">View and manage faculty records, departments, and active statuses.</p>
                </div>
                <div>
                    <RadzenButton Text="Add Teacher" Icon="add_circle" Click="ShowAddModal"
                                  ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Medium" />
                </div>
            </div>

            <!-- KPI Cards -->
            <div class="row g-4 mb-5">
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="dashboard-card">
                        <div class="kpi-label">Total Faculty</div>
                        <div class="kpi-number">@allTeachers.Count</div>
                    </div>
                </div>
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="dashboard-card">
                        <div class="kpi-label">Active Faculty</div>
                        <div class="kpi-number kpi-active">@allTeachers.Count(t => t.User?.IsActive == true)</div>
                    </div>
                </div>
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="dashboard-card">
                        <div class="kpi-label">Inactive Faculty</div>
                        <div class="kpi-number kpi-inactive">@allTeachers.Count(t => t.User?.IsActive == false)</div>
                    </div>
                </div>
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="dashboard-card">
                        <div class="kpi-label">Departments</div>
                        <div class="kpi-number text-warning">@departmentsList.Count</div>
                    </div>
                </div>
            </div>

            <!-- Grid Section -->
            <div class="dashboard-card p-4 mb-4">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
                    <h4 class="fw-bold mb-0 page-title-modern">Teacher Directory</h4>
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <RadzenTextBox @bind-Value="searchTerm" Placeholder="Search teachers..."
                                       Change="@(_ => ApplyFilters())" class="search-textbox" />
                        <RadzenDropDown Data="@departmentsDropdown" @bind-Value="departmentFilter"
                                       Change="@(_ => ApplyFilters())" class="role-dropdown" style="max-width: 180px;" />
                        <RadzenDropDown Data="@statusOptions" @bind-Value="statusFilter"
                                       Change="@(_ => ApplyFilters())" class="role-dropdown" style="max-width: 130px;" />
                    </div>
                </div>

                <RadzenDataGrid Data="@filteredTeachers" TItem="Teacher" AllowSorting="true" AllowPaging="true"
                                PageSize="10" GridLines="DataGridGridLines.Horizontal">
                    <Columns>
                        <RadzenDataGridColumn TItem="Teacher" Property="TeacherCode" Title="Teacher Code" Width="140px">
                            <Template Context="teacher">
                                <span class="font-monospace fw-semibold text-primary">@teacher.TeacherCode</span>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="Teacher" Title="Full Name">
                            <Template Context="teacher">
                                <div class="fw-bold text-dark">@teacher.User?.FullName</div>
                                <div class="text-secondary small">@@@(teacher.User?.Username ?? "N/A")</div>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="Teacher" Title="Email">
                            <Template Context="teacher">
                                <span class="text-secondary small">@teacher.User?.Email</span>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="Teacher" Property="Department" Title="Department" Width="180px">
                            <Template Context="teacher">
                                <span class="badge bg-secondary-subtle text-secondary fw-normal">
                                    @(string.IsNullOrWhiteSpace(teacher.Department) ? "Not Assigned" : teacher.Department)
                                </span>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="Teacher" Property="JoiningDate" Title="Joining Date" Width="160px">
                            <Template Context="teacher">
                                <span class="text-secondary small">@teacher.JoiningDate.ToLocalTime().ToString("MMM dd, yyyy")</span>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="Teacher" Title="Active" Width="90px" Sortable="false" TextAlign="TextAlign.Center">
                            <Template Context="teacher">
                                <div class="form-check form-switch mb-0 d-flex justify-content-center">
                                    <input class="form-check-input animate-switch" type="checkbox" role="switch"
                                           checked="@(teacher.User?.IsActive ?? false)" @onchange="() => ToggleActive(teacher)"
                                           title="@(teacher.User?.IsActive == true ? "Deactivate" : "Activate")" />
                                </div>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="Teacher" Title="Actions" Width="120px" Sortable="false" TextAlign="TextAlign.End">
                            <Template Context="teacher">
                                <RadzenButton Icon="edit" Click="@(() => ShowEditModal(teacher))"
                                              ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" class="me-1" title="Edit Teacher" />
                                <RadzenButton Icon="delete" Click="@(() => ConfirmDelete(teacher))"
                                              ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" title="Delete Teacher" />
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="d-flex flex-column align-items-center justify-content-center portal-loading-container">
            <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate"
                                       Size="ProgressBarCircularSize.Large" />
            <p class="mt-3 text-secondary fw-semibold">Loading Teacher Records...</p>
        </div>
    </NotAuthorized>
</AuthorizeView>

<style>
    .animate-switch {
        transition: background-color 0.15s ease-in-out, border-color 0.15s ease-in-out;
    }
</style>

@code {
    private List<Teacher> allTeachers = [];
    private List<Teacher> filteredTeachers = [];
    private List<string> departmentsList = [];
    private List<string> departmentsDropdown = ["All"];
    private string searchTerm = string.Empty;
    private string statusFilter = "All";
    private string departmentFilter = "All";
    private readonly List<string> statusOptions = ["All", "Active", "Inactive"];

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated != true)
            {
                Navigation.NavigateTo("/login");
                return;
            }
            var role = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
            if (role != "Admin")
            {
                Navigation.NavigateTo("/login");
            }
        }
    }

    private async Task LoadDataAsync()
    {
        try
        {
            allTeachers = await TeacherService.GetAllAsync();
            departmentsList = await TeacherService.GetDepartmentsAsync();
            
            departmentsDropdown = new List<string> { "All" };
            departmentsDropdown.AddRange(departmentsList);

            ApplyFilters();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", $"Failed to load teachers: {ex.Message}");
        }
    }

    private void ApplyFilters()
    {
        var result = allTeachers.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var q = searchTerm.Trim().ToLower();
            result = result.Where(t =>
                t.TeacherCode.ToLower().Contains(q) ||
                (t.User?.FullName != null && t.User.FullName.ToLower().Contains(q)) ||
                (t.User?.Email != null && t.User.Email.ToLower().Contains(q)) ||
                (t.Department != null && t.Department.ToLower().Contains(q))
            );
        }

        if (departmentFilter != "All")
        {
            result = result.Where(t => t.Department == departmentFilter);
        }

        if (statusFilter == "Active")
        {
            result = result.Where(t => t.User?.IsActive == true);
        }
        else if (statusFilter == "Inactive")
        {
            result = result.Where(t => t.User?.IsActive == false);
        }

        filteredTeachers = result.ToList();
    }

    private async Task ShowAddModal()
    {
        var result = await DialogService.OpenAsync<TeacherDialog>("Add New Teacher",
            new Dictionary<string, object?> { { "Teacher", null } },
            new DialogOptions { Width = "650px", Resizable = false, CloseDialogOnOverlayClick = true });

        if (result == true)
        {
            await LoadDataAsync();
        }
    }

    private async Task ShowEditModal(Teacher teacher)
    {
        // Clone the teacher context for safe editing
        var teacherClone = new Teacher
        {
            Id = teacher.Id,
            UserId = teacher.UserId,
            TeacherCode = teacher.TeacherCode,
            Department = teacher.Department,
            Qualification = teacher.Qualification,
            Phone = teacher.Phone,
            OfficeRoom = teacher.OfficeRoom,
            Bio = teacher.Bio,
            JoiningDate = teacher.JoiningDate,
            PhotoUrl = teacher.PhotoUrl,
            User = new User
            {
                Id = teacher.User.Id,
                FullName = teacher.User.FullName,
                Email = teacher.User.Email,
                Username = teacher.User.Username,
                IsActive = teacher.User.IsActive
            }
        };

        var result = await DialogService.OpenAsync<TeacherDialog>("Edit Teacher Profile",
            new Dictionary<string, object?> { { "Teacher", teacherClone } },
            new DialogOptions { Width = "650px", Resizable = false, CloseDialogOnOverlayClick = true });

        if (result == true)
        {
            await LoadDataAsync();
        }
    }

    private async Task ToggleActive(Teacher teacher)
    {
        try
        {
            await TeacherService.DeactivateAsync(teacher.Id);
            if (teacher.User != null)
            {
                teacher.User.IsActive = !teacher.User.IsActive;
            }
            ApplyFilters();
            NotificationService.Notify(NotificationSeverity.Success, "Status Updated", "Teacher status updated successfully.");
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", $"Failed to toggle status: {ex.Message}");
        }
    }

    private async Task ConfirmDelete(Teacher teacher)
    {
        var confirm = await DialogService.Confirm(
            $"Are you sure you want to permanently delete faculty member {teacher.User?.FullName} ({teacher.TeacherCode})? This action cannot be undone.",
            "Delete Teacher Account",
            new ConfirmOptions { OkButtonText = "Delete Permanently", CancelButtonText = "Cancel" });

        if (confirm == true)
        {
            try
            {
                await TeacherService.DeleteAsync(teacher.Id);
                await LoadDataAsync();
                NotificationService.Notify(NotificationSeverity.Warning, "Deleted", "Teacher has been removed.");
            }
            catch (Exception ex)
            {
                NotificationService.Notify(NotificationSeverity.Error, "Error", $"Could not delete teacher: {ex.Message}");
            }
        }
    }
}

@page "/admin/dashboard"
@inject UserService UserService
@inject CustomAuthStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject NotificationService NotificationService
@inject DialogService DialogService

<PageTitle>Admin Dashboard - Lyceum</PageTitle>

<AuthorizeView Roles="Admin" Context="authContext">
    <Authorized>
        <div class="container-fluid py-4 px-xl-5">
            <!-- Header Section -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="fw-bold mb-1 page-title-modern">System Administration</h1>
                    <p class="page-subtitle-modern">Manage users, adjust system roles, and monitor system activities.</p>
                </div>
                <RadzenButton Text="Add New User" Icon="person_add" Click="ShowAddUserModal"
                              ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Medium" />
            </div>

            <!-- Analytics Section -->
            <div class="row g-4 mb-4">
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="dashboard-card">
                        <div class="stat-icon bg-primary-subtle text-primary">
                            <i class="bi bi-people-fill"></i>
                        </div>
                        <div class="text-secondary small fw-semibold text-uppercase mb-1">Total Users</div>
                        <h3 class="fw-bold mb-0 text-dark">@totalUsersCount</h3>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="dashboard-card">
                        <div class="stat-icon bg-success-subtle text-success">
                            <i class="bi bi-mortarboard-fill"></i>
                        </div>
                        <div class="text-secondary small fw-semibold text-uppercase mb-1">Total Students</div>
                        <h3 class="fw-bold mb-0 text-dark">@studentsCount</h3>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="dashboard-card">
                        <div class="stat-icon bg-warning-subtle text-warning">
                            <i class="bi bi-person-workspace"></i>
                        </div>
                        <div class="text-secondary small fw-semibold text-uppercase mb-1">Total Teachers</div>
                        <h3 class="fw-bold mb-0 text-dark">@teachersCount</h3>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="dashboard-card">
                        <div class="stat-icon bg-danger-subtle text-danger">
                            <i class="bi bi-shield-lock-fill"></i>
                        </div>
                        <div class="text-secondary small fw-semibold text-uppercase mb-1">Total Admins</div>
                        <h3 class="fw-bold mb-0 text-dark">@adminsCount</h3>
                    </div>
                </div>
            </div>

            <!-- Visual Charts & Activity Overview Row -->
            <div class="row g-4 mb-4">
                <div class="col-12 col-lg-4">
                    <div class="dashboard-card p-4 h-100">
                        <h5 class="fw-bold mb-3 text-dark">User Distribution</h5>
                        <RadzenChart class="admin-donut-chart">
                            <RadzenDonutSeries Data="@roleChartData" CategoryProperty="Role" ValueProperty="Count" Title="Users">
                                <TitleTemplate>
                                    <div class="rz-donut-title donut-title-text">
                                        Total
                                        <span class="donut-title-count">@totalUsersCount</span>
                                    </div>
                                </TitleTemplate>
                            </RadzenDonutSeries>
                        </RadzenChart>
                    </div>
                </div>
                <div class="col-12 col-lg-8">
                    <div class="dashboard-card p-4 h-100">
                        <h5 class="fw-bold mb-3 text-dark">Administrative Actions & Quick Access</h5>
                        <div class="row g-3">
                            <div class="col-12 col-sm-6">
                                <div class="p-3 border rounded-3 d-flex align-items-center gap-3 bg-light">
                                    <div class="stat-icon bg-primary-subtle text-primary mb-0 shadow-sm action-card-icon">
                                        <i class="bi bi-person-add"></i>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold mb-0 action-title-primary" @onclick="ShowAddUserModal">Register New User</h6>
                                        <span class="text-secondary small">Add student, teacher, or admin</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-sm-6">
                                <div class="p-3 border rounded-3 d-flex align-items-center gap-3 bg-light">
                                    <div class="stat-icon bg-success-subtle text-success mb-0 shadow-sm action-card-icon">
                                        <i class="bi bi-book"></i>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold mb-0"><a href="/admin/courses" class="action-title-success">Manage Courses</a></h6>
                                        <span class="text-secondary small">Add, update, or schedule courses</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- User Grid Section -->
            <div class="dashboard-card p-4 mb-4">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
                    <h4 class="fw-bold mb-0 page-title-modern section-title-medium">User Directory</h4>

                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <RadzenTextBox @bind-Value="searchTerm" Placeholder="Search by name or username..." Change="@(_ => FilterUsers())"
                                       class="search-textbox" />
                        <RadzenDropDown Data="@roleOptions" @bind-Value="roleFilter" Change="@(_ => FilterUsers())"
                                       class="role-dropdown" />
                    </div>
                </div>

                <RadzenDataGrid Data="@filteredUsers" TItem="User" AllowSorting="true" AllowPaging="true"
                                PageSize="10" AllowColumnResize="false" GridLines="DataGridGridLines.Horizontal">
                    <Columns>
                        <RadzenDataGridColumn TItem="User" Title="User Info" Sortable="false">
                            <Template Context="user">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="stat-icon mb-0 d-none d-sm-flex user-grid-icon" style="@GetRoleIconStyle(user.Role)">
                                        @if (user.Role == UserRole.Admin)
                                        {
                                            <i class="bi bi-shield-lock-fill"></i>
                                        }
                                        else if (user.Role == UserRole.Teacher)
                                        {
                                            <i class="bi bi-person-workspace"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-mortarboard-fill"></i>
                                        }
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark">@user.FullName</div>
                                        <div class="text-secondary small">
                                            <span>@@@user.Username</span>
                                            <span class="mx-1">•</span>
                                            <span>@user.Email</span>
                                        </div>
                                    </div>
                                </div>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="User" Property="Role" Title="Role" Width="110px">
                            <Template Context="user">
                                @if (user.Role == UserRole.Admin)
                                {
                                    <span class="badge-role badge-admin">Admin</span>
                                }
                                else if (user.Role == UserRole.Teacher)
                                {
                                    <span class="badge-role badge-teacher">Teacher</span>
                                }
                                else
                                {
                                    <span class="badge-role badge-student">Student</span>
                                }
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="User" Title="Details" Sortable="false">
                            <Template Context="user">
                                <div class="small">
                                    @if (user.Role == UserRole.Student)
                                    {
                                        <span class="text-secondary">ID:</span> <span class="fw-semibold">@user.StudentId</span>
                                        <br />
                                        <span class="text-secondary">GPA:</span>
                                        <span class="badge bg-success-subtle text-success font-monospace ms-1">@user.GPA?.ToString("0.00")</span>
                                    }
                                    else if (user.Role == UserRole.Teacher)
                                    {
                                        <span class="text-secondary">Dept:</span> <span class="fw-semibold">@user.Department</span>
                                        <br />
                                        <span class="text-secondary">ID:</span> <span class="fw-semibold">@user.TeacherId</span>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">—</span>
                                    }
                                </div>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="User" Property="CreatedAt" Title="Registered" Width="130px">
                            <Template Context="user">
                                <span class="text-secondary small">@user.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")</span>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="User" Title="" Width="100px" Sortable="false" TextAlign="TextAlign.End">
                            <Template Context="user">
                                <RadzenButton Icon="edit" Click="@(() => ShowEditUserModal(user))"
                                              ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                              title="Edit User" class="me-1" />
                                <RadzenButton Icon="delete" Click="@(() => ConfirmDeleteUser(user))"
                                              ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                              title="Delete User" />
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="d-flex flex-column align-items-center justify-content-center portal-loading-container">
            <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate"
                                       Size="ProgressBarCircularSize.Large" />
            <p class="mt-3 text-secondary fw-semibold">Loading Admin Portal...</p>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private List<User> allUsers = new();
    private List<User> filteredUsers = new();
    private string searchTerm = string.Empty;
    private string roleFilter = "All";

    private readonly List<string> roleOptions = ["All", "Admin", "Teacher", "Student"];

    private int totalUsersCount;
    private int studentsCount;
    private int teachersCount;
    private int adminsCount;

    private List<RoleChartItem> roleChartData = new();

    public class RoleChartItem
    {
        public string Role { get; set; } = string.Empty;
        public int Count { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadUsersAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated != true)
            {
                Navigation.NavigateTo("/login");
            }
            else
            {
                var role = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
                if (role != "Admin")
                    Navigation.NavigateTo("/login");
            }
        }
    }

    private async Task LoadUsersAsync()
    {
        allUsers = await UserService.GetAllUsersAsync();
        totalUsersCount = allUsers.Count;
        studentsCount = allUsers.Count(u => u.Role == UserRole.Student);
        teachersCount = allUsers.Count(u => u.Role == UserRole.Teacher);
        adminsCount = allUsers.Count(u => u.Role == UserRole.Admin);

        roleChartData = new List<RoleChartItem>
        {
            new() { Role = "Students", Count = studentsCount },
            new() { Role = "Teachers", Count = teachersCount },
            new() { Role = "Admins", Count = adminsCount }
        };

        FilterUsers();
    }

    private void FilterUsers()
    {
        var result = allUsers.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var search = searchTerm.ToLower();
            result = result.Where(u =>
                (u.FullName != null && u.FullName.ToLower().Contains(search)) ||
                (u.Username != null && u.Username.ToLower().Contains(search)) ||
                (u.Email != null && u.Email.ToLower().Contains(search)));
        }

        if (roleFilter != "All")
        {
            var role = Enum.Parse<UserRole>(roleFilter);
            result = result.Where(u => u.Role == role);
        }

        filteredUsers = result.ToList();
    }

    private async Task ShowAddUserModal()
    {
        var user = new User { Role = UserRole.Student };
        var result = await DialogService.OpenAsync<UserDialog>("Add New User",
            new Dictionary<string, object?> { { "User", user } },
            new DialogOptions { Width = "600px", Resizable = false, CloseDialogOnOverlayClick = true });

        if (result == true)
        {
            await LoadUsersAsync();
        }
    }

    private async Task ShowEditUserModal(User user)
    {
        // Clone the user to prevent data updates on the grid prior to DB save
        var userClone = new User
        {
            Id = user.Id,
            Username = user.Username,
            FullName = user.FullName,
            Email = user.Email,
            Role = user.Role,
            CreatedAt = user.CreatedAt,
            StudentId = user.StudentId,
            GradeLevel = user.GradeLevel,
            GPA = user.GPA,
            AttendanceRate = user.AttendanceRate,
            TeacherId = user.TeacherId,
            Department = user.Department,
            Bio = user.Bio,
            OfficeRoom = user.OfficeRoom
        };

        var result = await DialogService.OpenAsync<UserDialog>("Edit User Profile",
            new Dictionary<string, object?> { { "User", userClone } },
            new DialogOptions { Width = "600px", Resizable = false, CloseDialogOnOverlayClick = true });

        if (result == true)
        {
            await LoadUsersAsync();
        }
    }

    private async Task ConfirmDeleteUser(User user)
    {
        var confirm = await DialogService.Confirm(
            $"Are you sure you want to delete {user.FullName} (@{user.Username})? This action is permanent and cannot be undone.",
            "Delete User Account",
            new ConfirmOptions { OkButtonText = "Delete Permanently", CancelButtonText = "Cancel" });

        if (confirm == true)
        {
            try
            {
                await UserService.DeleteUserAsync(user.Id);
                await LoadUsersAsync();
                NotificationService.Notify(NotificationSeverity.Warning, "Deleted", "User has been removed.");
            }
            catch (Exception ex)
            {
                NotificationService.Notify(NotificationSeverity.Error, "Error", $"Could not delete user: {ex.Message}");
            }
        }
    }

    private string GetRoleIconStyle(UserRole role) => role switch
    {
        UserRole.Admin => "background-color:#fef2f2;color:#b91c1c;",
        UserRole.Teacher => "background-color:#fffbeb;color:#b45309;",
        _ => "background-color:#eff6ff;color:#1d4ed8;"
    };
}

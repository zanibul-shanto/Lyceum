@page "/admin/dashboard"
@inject UserService UserService
@inject CustomAuthStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Admin Dashboard - Lyceum</PageTitle>

<AuthorizeView Roles="Admin" Context="authContext">
    <Authorized>
        <div class="w-100">
            <!-- Header Section -->
            <div class="d-flex justify-between align-center mb-6">
                <div>
                    <MudText Typo="Typo.h4" Class="font-weight-bold mb-1" Style="font-family: 'Outfit', sans-serif;">System administration</MudText>
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Manage users, adjust system roles, and monitor system activities.</MudText>
                </div>
                <MudButton OnClick="ShowAddUserModal" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" Class="py-2 px-4 font-weight-bold" Style="text-transform: none; border-radius: 8px;">
                    Add New User
                </MudButton>
            </div>

            <!-- KPI Row -->
            <MudGrid Class="mb-6">
                <MudItem XS="12" SM="6" MD="3">
                    <MudPaper Class="pa-6 border d-flex align-center gap-4" Elevation="0" Style="background-color: white; border-radius: 12px; height: 100%;">
                        <div class="d-flex align-center justify-center rounded-lg" style="width: 48px; height: 48px; background-color: var(--mud-palette-primary-lighten); color: var(--mud-palette-primary);">
                            <MudIcon Icon="@Icons.Material.Filled.People" />
                        </div>
                        <div>
                            <MudText Typo="Typo.overline" Color="Color.Secondary" Style="font-weight: 700;">Total Users</MudText>
                            <MudText Typo="Typo.h4" Class="font-weight-bold" Style="font-family: 'Outfit', sans-serif;">@totalUsersCount</MudText>
                        </div>
                    </MudPaper>
                </MudItem>
                <MudItem XS="12" SM="6" MD="3">
                    <MudPaper Class="pa-6 border d-flex align-center gap-4" Elevation="0" Style="background-color: white; border-radius: 12px; height: 100%;">
                        <div class="d-flex align-center justify-center rounded-lg" style="width: 48px; height: 48px; background-color: var(--mud-palette-success-lighten); color: var(--mud-palette-success);">
                            <MudIcon Icon="@Icons.Material.Filled.School" />
                        </div>
                        <div>
                            <MudText Typo="Typo.overline" Color="Color.Secondary" Style="font-weight: 700;">Total Students</MudText>
                            <MudText Typo="Typo.h4" Class="font-weight-bold" Style="font-family: 'Outfit', sans-serif;">@studentsCount</MudText>
                        </div>
                    </MudPaper>
                </MudItem>
                <MudItem XS="12" SM="6" MD="3">
                    <MudPaper Class="pa-6 border d-flex align-center gap-4" Elevation="0" Style="background-color: white; border-radius: 12px; height: 100%;">
                        <div class="d-flex align-center justify-center rounded-lg" style="width: 48px; height: 48px; background-color: var(--mud-palette-warning-lighten); color: var(--mud-palette-warning);">
                            <MudIcon Icon="@Icons.Material.Filled.WorkspacePremium" />
                        </div>
                        <div>
                            <MudText Typo="Typo.overline" Color="Color.Secondary" Style="font-weight: 700;">Total Teachers</MudText>
                            <MudText Typo="Typo.h4" Class="font-weight-bold" Style="font-family: 'Outfit', sans-serif;">@teachersCount</MudText>
                        </div>
                    </MudPaper>
                </MudItem>
                <MudItem XS="12" SM="6" MD="3">
                    <MudPaper Class="pa-6 border d-flex align-center gap-4" Elevation="0" Style="background-color: white; border-radius: 12px; height: 100%;">
                        <div class="d-flex align-center justify-center rounded-lg" style="width: 48px; height: 48px; background-color: var(--mud-palette-error-lighten); color: var(--mud-palette-error);">
                            <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" />
                        </div>
                        <div>
                            <MudText Typo="Typo.overline" Color="Color.Secondary" Style="font-weight: 700;">Total Admins</MudText>
                            <MudText Typo="Typo.h4" Class="font-weight-bold" Style="font-family: 'Outfit', sans-serif;">@adminsCount</MudText>
                        </div>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            <!-- User Directory Table -->
            <MudCard Class="border mb-4" Elevation="0" Style="background-color: white; border-radius: 12px;">
                <MudCardHeader Class="pb-2">
                    <CardHeaderContent>
                        <div class="d-flex flex-column flex-md-row justify-between align-start align-md-center gap-4">
                            <MudText Typo="Typo.h5" Class="font-weight-bold" Style="font-family: 'Outfit', sans-serif;">User Directory</MudText>
                            
                            <div class="d-flex flex-wrap gap-3 align-center" style="min-width: 320px;">
                                <!-- Search Input -->
                                <MudTextField @bind-Value="searchTerm" Placeholder="Search by name or username..." 
                                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" 
                                              Variant="Variant.Outlined" Margin="Margin.Dense" Class="bg-white rounded-lg" Immediate="true" />
                                
                                <!-- Role Filter Select -->
                                <MudSelect T="string" @bind-Value="roleFilter" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 150px;">
                                    <MudSelectItem Value="@("All")">All Roles</MudSelectItem>
                                    <MudSelectItem Value="@("Admin")">Administrators</MudSelectItem>
                                    <MudSelectItem Value="@("Teacher")">Teachers</MudSelectItem>
                                    <MudSelectItem Value="@("Student")">Students</MudSelectItem>
                                </MudSelect>
                            </div>
                        </div>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent Class="pa-0">
                    <MudTable Items="filteredUsers" Elevation="0" Class="border-0" Hover="true">
                        <HeaderContent>
                            <MudTh>User Info</MudTh>
                            <MudTh>Role</MudTh>
                            <MudTh>Details</MudTh>
                            <MudTh>Registered</MudTh>
                            <MudTh Style="text-align: right;">Actions</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="User Info">
                                <div class="d-flex align-center">
                                    <MudAvatar Color="@GetRoleAvatarColor(context.Role)" Variant="Variant.Text" Class="mr-3" Style="@($"background-color: {GetRoleAvatarBg(context.Role)}; font-weight: bold; border-radius: 8px;")">
                                        <MudIcon Icon="@GetRoleIcon(context.Role)" />
                                    </MudAvatar>
                                    <div>
                                        <MudText Typo="Typo.body2" Class="font-weight-bold">@context.FullName</MudText>
                                        <div class="d-flex align-center gap-1">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@@@context.Username</MudText>
                                            <span style="color: var(--mud-palette-text-disabled); font-size: 0.8rem;">•</span>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Email</MudText>
                                        </div>
                                    </div>
                                </div>
                            </MudTd>
                            <MudTd DataLabel="Role">
                                <MudChip T="string" Color="@GetRoleAvatarColor(context.Role)" Size="Size.Small" Style="font-weight: bold; border-radius: 4px;">
                                    @context.Role
                                </MudChip>
                            </MudTd>
                            <MudTd DataLabel="Details">
                                <div class="d-flex flex-column">
                                    @if (context.Role == UserRole.Student)
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">ID: <b>@context.StudentId</b></MudText>
                                        <div class="d-flex align-center gap-1">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">GPA:</MudText>
                                            <MudChip T="string" Color="Color.Success" Variant="Variant.Text" Size="Size.Small" Class="pa-0 font-weight-bold" Style="height: 18px; font-family: monospace;">@context.GPA?.ToString("0.00")</MudChip>
                                        </div>
                                    }
                                    else if (context.Role == UserRole.Teacher)
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Dept: <b>@context.Department</b></MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">ID: <b>@context.TeacherId</b></MudText>
                                    }
                                    else
                                    {
                                        <span style="color: var(--mud-palette-text-disabled);">—</span>
                                    }
                                </div>
                            </MudTd>
                            <MudTd DataLabel="Registered">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">@context.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")</MudText>
                            </MudTd>
                            <MudTd DataLabel="Actions" Style="text-align: right;">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" OnClick="() => ShowEditUserModal(context)" Size="Size.Small" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="() => ConfirmDeleteUser(context)" Size="Size.Small" />
                            </MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <div class="text-center py-6 text-secondary">
                                <MudIcon Icon="@Icons.Material.Filled.PeopleOutline" Style="font-size: 2.5rem;" Color="Color.Default" Class="mb-2" />
                                <MudText Typo="Typo.body2" Style="font-weight: bold;">No users found matching current filters.</MudText>
                            </div>
                        </NoRecordsContent>
                    </MudTable>
                </MudCardContent>
            </MudCard>

            <!-- Modal: Add / Edit User -->
            <MudDialog @bind-Visible="isUserModalVisible" Options="_userDialogOptions">
                <TitleContent>
                    <MudText Typo="Typo.h6" Class="font-weight-bold" Style="font-family: 'Outfit', sans-serif;">
                        @(editingUser.Id == 0 ? "Add New User" : "Edit User Profile")
                    </MudText>
                </TitleContent>
                <DialogContent>
                    @if (!string.IsNullOrEmpty(modalErrorMessage))
                    {
                        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4 rounded-lg" Elevation="0">
                            @modalErrorMessage
                        </MudAlert>
                    }

                    <EditForm Model="editingUser" OnValidSubmit="SaveUser" FormName="UserEditForm">
                        <DataAnnotationsValidator />

                        <MudGrid Class="g-3">
                            <MudItem XS="12" SM="6">
                                <MudTextField Label="Username" @bind-Value="editingUser.Username" 
                                              For="() => editingUser.Username" Variant="Variant.Outlined" 
                                              Disabled="@(editingUser.Id != 0)" Placeholder="Enter username" Margin="Margin.Dense" Required="true" />
                            </MudItem>

                            <MudItem XS="12" SM="6">
                                <MudTextField Label="Full Name" @bind-Value="editingUser.FullName" 
                                              For="() => editingUser.FullName" Variant="Variant.Outlined" 
                                              Placeholder="Enter full name" Margin="Margin.Dense" Required="true" />
                            </MudItem>

                            <MudItem XS="12" SM="6">
                                <MudTextField Label="Email Address" @bind-Value="editingUser.Email" 
                                              For="() => editingUser.Email" Variant="Variant.Outlined" 
                                              Placeholder="Enter email" Margin="Margin.Dense" Required="true" />
                            </MudItem>

                            <MudItem XS="12" SM="6">
                                <MudSelect T="UserRole" Label="System Role" @bind-Value="editingUser.Role" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true">
                                    <MudSelectItem Value="UserRole.Student">Student</MudSelectItem>
                                    <MudSelectItem Value="UserRole.Teacher">Teacher</MudSelectItem>
                                    <MudSelectItem Value="UserRole.Admin">Administrator</MudSelectItem>
                                </MudSelect>
                            </MudItem>

                            @if (editingUser.Id == 0)
                            {
                                <MudItem XS="12">
                                    <MudTextField Label="Password" @bind-Value="newUserPassword" 
                                                  Variant="Variant.Outlined" InputType="InputType.Password"
                                                  Placeholder="Enter temporary password" Margin="Margin.Dense" Required="true" />
                                </MudItem>
                            }

                            <!-- Dynamic Section for Students -->
                            @if (editingUser.Role == UserRole.Student)
                            {
                                <MudItem XS="12">
                                    <MudCard Outlined="true" Class="pa-4 border" Style="background-color: var(--mud-palette-background-gray); border-radius: 8px;">
                                        <div class="d-flex align-center mb-3">
                                            <MudIcon Icon="@Icons.Material.Filled.School" Color="Color.Primary" Class="mr-2" />
                                            <MudText Typo="Typo.subtitle2" Class="font-weight-bold">Student Details</MudText>
                                        </div>
                                        <MudGrid Class="g-2">
                                            <MudItem XS="12" SM="6">
                                                <MudTextField Label="Student ID (Optional)" @bind-Value="editingUser.StudentId" 
                                                              Variant="Variant.Outlined" Placeholder="e.g. STU-2026-001" Margin="Margin.Dense" />
                                            </MudItem>
                                            <MudItem XS="12" SM="6">
                                                <MudSelect T="string" Label="Grade Level" @bind-Value="editingUser.GradeLevel" Variant="Variant.Outlined" Margin="Margin.Dense">
                                                    <MudSelectItem Value="@("")">Select Grade</MudSelectItem>
                                                    <MudSelectItem Value="@("Freshman (1st Year)")">Freshman (1st Year)</MudSelectItem>
                                                    <MudSelectItem Value="@("Sophomore (2nd Year)")">Sophomore (2nd Year)</MudSelectItem>
                                                    <MudSelectItem Value="@("Junior (3rd Year)")">Junior (3rd Year)</MudSelectItem>
                                                    <MudSelectItem Value="@("Senior (4th Year)")">Senior (4th Year)</MudSelectItem>
                                                </MudSelect>
                                            </MudItem>
                                            <MudItem XS="6">
                                                <MudNumericField T="double?" Label="GPA" @bind-Value="editingUser.GPA" 
                                                                 Min="0.0" Max="4.0" Step="0.01" Format="0.00" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                            </MudItem>
                                            <MudItem XS="6">
                                                <MudNumericField T="double?" Label="Attendance Rate (%)" @bind-Value="editingUser.AttendanceRate" 
                                                                 Min="0.0" Max="100.0" Step="0.1" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                            </MudItem>
                                        </MudGrid>
                                    </MudCard>
                                </MudItem>
                            }

                            <!-- Dynamic Section for Teachers -->
                            @if (editingUser.Role == UserRole.Teacher)
                            {
                                <MudItem XS="12">
                                    <MudCard Outlined="true" Class="pa-4 border" Style="background-color: var(--mud-palette-background-gray); border-radius: 8px;">
                                        <div class="d-flex align-center mb-3">
                                            <MudIcon Icon="@Icons.Material.Filled.WorkspacePremium" Color="Color.Warning" Class="mr-2" />
                                            <MudText Typo="Typo.subtitle2" Class="font-weight-bold">Teacher Details</MudText>
                                        </div>
                                        <MudGrid Class="g-2">
                                            <MudItem XS="12" SM="6">
                                                <MudTextField Label="Teacher ID (Optional)" @bind-Value="editingUser.TeacherId" 
                                                              Variant="Variant.Outlined" Placeholder="e.g. TCH-2026-042" Margin="Margin.Dense" />
                                            </MudItem>
                                            <MudItem XS="12" SM="6">
                                                <MudSelect T="string" Label="Department" @bind-Value="editingUser.Department" Variant="Variant.Outlined" Margin="Margin.Dense">
                                                    <MudSelectItem Value="@("")">Select Department</MudSelectItem>
                                                    <MudSelectItem Value="@("Computer Science & Engineering")">Computer Science & Engineering</MudSelectItem>
                                                    <MudSelectItem Value="@("Mathematics")">Mathematics</MudSelectItem>
                                                    <MudSelectItem Value="@("Physics")">Physics</MudSelectItem>
                                                    <MudSelectItem Value="@("Chemistry")">Chemistry</MudSelectItem>
                                                    <MudSelectItem Value="@("Humanities")">Humanities</MudSelectItem>
                                                </MudSelect>
                                            </MudItem>
                                            <MudItem XS="12">
                                                <MudTextField Label="Office Room" @bind-Value="editingUser.OfficeRoom" 
                                                              Variant="Variant.Outlined" Placeholder="e.g. Science Hall, Rm 302" Margin="Margin.Dense" />
                                            </MudItem>
                                            <MudItem XS="12">
                                                <MudTextField Label="Biography" @bind-Value="editingUser.Bio" Lines="2"
                                                              Variant="Variant.Outlined" Placeholder="Brief professional background..." Margin="Margin.Dense" />
                                            </MudItem>
                                        </MudGrid>
                                    </MudCard>
                                </MudItem>
                            }
                        </MudGrid>

                        <div class="d-flex justify-end gap-3 mt-6">
                            <MudButton OnClick="CloseUserModal" Variant="Variant.Text" Color="Color.Secondary" Style="text-transform: none; font-weight: bold;">Cancel</MudButton>
                            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" Style="text-transform: none; font-weight: bold; border-radius: 8px;">Save Changes</MudButton>
                        </div>
                    </EditForm>
                </DialogContent>
            </MudDialog>

            <!-- Modal: Delete Confirmation -->
            <MudDialog @bind-Visible="isDeleteModalVisible" Options="_deleteDialogOptions">
                <TitleContent>
                    <MudText Typo="Typo.h6" Class="font-weight-bold" Style="font-family: 'Outfit', sans-serif;">Confirm Deletion</MudText>
                </TitleContent>
                <DialogContent>
                    <div class="text-center py-4">
                        <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error" Style="font-size: 3rem;" Class="mb-3" />
                        <MudText Typo="Typo.h6" Class="font-weight-bold mb-2">Delete Account?</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="px-4">
                            Are you sure you want to delete user <strong>@userToDelete?.FullName</strong> (@@@userToDelete?.Username)?
                            This action is permanent and cannot be undone.
                        </MudText>
                    </div>
                </DialogContent>
                <DialogActions>
                    <div class="d-flex justify-center gap-3 w-100 pb-4">
                        <MudButton OnClick="CloseDeleteModal" Variant="Variant.Text" Color="Color.Secondary" Style="text-transform: none; font-weight: bold; width: 120px;">Cancel</MudButton>
                        <MudButton OnClick="DeleteUser" Variant="Variant.Filled" Color="Color.Error" Style="text-transform: none; font-weight: bold; border-radius: 8px; width: 160px;">Delete Permanently</MudButton>
                    </div>
                </DialogActions>
            </MudDialog>
        </div>
    </Authorized>
    <NotAuthorized>
        <!-- Premium Loader during pre-render session loading -->
        <div class="d-flex flex-column align-center justify-center" style="min-height: 80vh;">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
            <MudText Class="mt-4 text-secondary font-weight-bold">Loading Admin Portal...</MudText>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private List<User> allUsers = new();
    private List<User> filteredUsers = new();
    
    // Custom getter/setter binds to easily react to search inputs
    private string _searchTerm = string.Empty;
    private string searchTerm
    {
        get => _searchTerm;
        set
        {
            if (_searchTerm != value)
            {
                _searchTerm = value;
                FilterUsers();
            }
        }
    }

    private string _roleFilter = "All";
    private string roleFilter
    {
        get => _roleFilter;
        set
        {
            if (_roleFilter != value)
            {
                _roleFilter = value;
                FilterUsers();
            }
        }
    }

    // Analytics Counts
    private int totalUsersCount;
    private int studentsCount;
    private int teachersCount;
    private int adminsCount;

    // Modals State
    private bool isUserModalVisible;
    private bool isDeleteModalVisible;
    private User editingUser = new();
    private string newUserPassword = string.Empty;
    private User? userToDelete;
    private string? modalErrorMessage;

    private readonly DialogOptions _userDialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
    private readonly DialogOptions _deleteDialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };

    protected override async Task OnInitializedAsync()
    {
        await LoadUsersAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated != true)
            {
                Navigation.NavigateTo("/login");
            }
            else
            {
                var role = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
                if (role != "Admin")
                {
                    Navigation.NavigateTo("/login");
                }
            }
        }
    }

    private async Task LoadUsersAsync()
    {
        allUsers = await UserService.GetAllUsersAsync();
        
        // Calculate analytics
        totalUsersCount = allUsers.Count;
        studentsCount = allUsers.Count(u => u.Role == UserRole.Student);
        teachersCount = allUsers.Count(u => u.Role == UserRole.Teacher);
        adminsCount = allUsers.Count(u => u.Role == UserRole.Admin);

        FilterUsers();
    }

    private void FilterUsers()
    {
        var result = allUsers.AsEnumerable();

        // Search text filter
        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var search = searchTerm.ToLower();
            result = result.Where(u => (u.FullName != null && u.FullName.ToLower().Contains(search)) || 
                                       (u.Username != null && u.Username.ToLower().Contains(search)) ||
                                       (u.Email != null && u.Email.ToLower().Contains(search)));
        }

        // Role filter
        if (roleFilter != "All")
        {
            var role = Enum.Parse<UserRole>(roleFilter);
            result = result.Where(u => u.Role == role);
        }

        filteredUsers = result.ToList();
        StateHasChanged();
    }

    // Modal Control: Add
    private void ShowAddUserModal()
    {
        editingUser = new User { Role = UserRole.Student };
        newUserPassword = string.Empty;
        modalErrorMessage = null;
        isUserModalVisible = true;
    }

    // Modal Control: Edit
    private void ShowEditUserModal(User user)
    {
        // Shallow copy for editing so original record isn't affected until saved
        editingUser = new User
        {
            Id = user.Id,
            Username = user.Username,
            FullName = user.FullName,
            Email = user.Email,
            Role = user.Role,
            CreatedAt = user.CreatedAt,
            StudentId = user.StudentId,
            GradeLevel = user.GradeLevel,
            GPA = user.GPA,
            AttendanceRate = user.AttendanceRate,
            TeacherId = user.TeacherId,
            Department = user.Department,
            Bio = user.Bio,
            OfficeRoom = user.OfficeRoom
        };
        modalErrorMessage = null;
        isUserModalVisible = true;
    }

    private void CloseUserModal()
    {
        isUserModalVisible = false;
        editingUser = new User();
        newUserPassword = string.Empty;
    }

    // Save
    private async Task SaveUser()
    {
        modalErrorMessage = null;
        try
        {
            if (editingUser.Id == 0)
            {
                if (string.IsNullOrWhiteSpace(newUserPassword))
                {
                    modalErrorMessage = "Password is required for new users.";
                    return;
                }
                
                await UserService.RegisterAsync(editingUser, newUserPassword);
            }
            else
            {
                await UserService.UpdateUserAsync(editingUser);
            }

            CloseUserModal();
            await LoadUsersAsync();
        }
        catch (Exception ex)
        {
            modalErrorMessage = ex.Message;
        }
    }

    // Delete Flow
    private void ConfirmDeleteUser(User user)
    {
        userToDelete = user;
        isDeleteModalVisible = true;
    }

    private void CloseDeleteModal()
    {
        isDeleteModalVisible = false;
        userToDelete = null;
    }

    private async Task DeleteUser()
    {
        if (userToDelete != null)
        {
            try
            {
                await UserService.DeleteUserAsync(userToDelete.Id);
                CloseDeleteModal();
                await LoadUsersAsync();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error deleting user: {ex.Message}");
            }
        }
    }

    // Helper functions for tables and chips
    private Color GetRoleAvatarColor(UserRole role)
    {
        return role switch
        {
            UserRole.Admin => Color.Error,
            UserRole.Teacher => Color.Warning,
            UserRole.Student => Color.Primary,
            _ => Color.Default
        };
    }

    private string GetRoleAvatarBg(UserRole role)
    {
        return role switch
        {
            UserRole.Admin => "var(--mud-palette-error-lighten)",
            UserRole.Teacher => "var(--mud-palette-warning-lighten)",
            UserRole.Student => "var(--mud-palette-primary-lighten)",
            _ => "var(--mud-palette-background-grey)"
        };
    }

    private string GetRoleIcon(UserRole role)
    {
        return role switch
        {
            UserRole.Admin => Icons.Material.Filled.AdminPanelSettings,
            UserRole.Teacher => Icons.Material.Filled.WorkspacePremium,
            UserRole.Student => Icons.Material.Filled.School,
            _ => Icons.Material.Filled.Person
        };
    }
}

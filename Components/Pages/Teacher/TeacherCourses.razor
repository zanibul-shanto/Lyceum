@page "/teacher/courses"
@inject TeacherService TeacherService
@inject TimetableService TimetableService
@inject EnrollmentService EnrollmentService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>My Courses - Lyceum</PageTitle>

<AuthorizeView Roles="Teacher">
    <Authorized>
        <div class="container-fluid py-4 px-xl-5">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h3 class="fw-bold mb-1 page-title-modern text-white">My Courses</h3>
                    <p class="page-subtitle-modern mb-0 text-secondary">View and manage courses assigned to you.</p>
                </div>
            </div>

            @if (loading)
            {
                <div class="d-flex flex-column align-items-center justify-content-center py-5">
                    <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Large" />
                    <p class="mt-3 text-secondary fw-semibold">Loading courses...</p>
                </div>
            }
            else if (!assignedCourses.Any())
            {
                <div class="alert alert-info py-3 shadow-sm border-0">
                    <i class="bi bi-info-circle-fill me-2"></i>
                    No courses have been assigned to you for this academic cycle.
                </div>
            }
            else
            {
                <div class="dashboard-card p-4">
                    <RadzenDataGrid Data="@assignedCourses" TItem="Course" AllowSorting="true" AllowPaging="true" PageSize="10" GridLines="DataGridGridLines.Horizontal">
                        <Template Context="course">
                            <div class="p-3 bg-light rounded border border-primary-subtle">
                                <div class="d-flex align-items-center mb-3">
                                    <div class="stat-icon bg-primary-subtle text-primary me-2 mb-0 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; font-size: 0.9rem;">
                                        <i class="bi bi-people-fill"></i>
                                    </div>
                                    <h6 class="fw-bold mb-0 text-dark">Enrolled Students in @course.Name</h6>
                                </div>
                                @if (courseEnrollments.TryGetValue(course.Id, out var enrollments) && enrollments.Any())
                                {
                                    <RadzenDataGrid Data="@enrollments" TItem="StudentEnrollment" AllowPaging="true" PageSize="5">
                                        <Columns>
                                            <RadzenDataGridColumn TItem="StudentEnrollment" Title="Student Name">
                                                <Template Context="enrollment">
                                                    <div class="fw-bold text-dark">@enrollment.Student?.User?.FullName</div>
                                                    <div class="text-secondary small">@enrollment.Student?.User?.Email</div>
                                                </Template>
                                            </RadzenDataGridColumn>
                                            <RadzenDataGridColumn TItem="StudentEnrollment" Property="Student.StudentCode" Title="Student Code" Width="150px" />
                                            <RadzenDataGridColumn TItem="StudentEnrollment" Title="Enroll Date" Width="150px">
                                                <Template Context="enrollment">
                                                    <span>@enrollment.EnrollmentDate.ToString("yyyy-MM-dd")</span>
                                                </Template>
                                            </RadzenDataGridColumn>
                                        </Columns>
                                    </RadzenDataGrid>
                                }
                                else
                                {
                                    <p class="text-muted small mb-0">No students are currently enrolled in this course.</p>
                                }
                            </div>
                        </Template>
                        <Columns>
                            <RadzenDataGridColumn TItem="Course" Property="CourseCode" Title="Code" Width="120px" />
                            <RadzenDataGridColumn TItem="Course" Property="Name" Title="Course Name" />
                            <RadzenDataGridColumn TItem="Course" Property="Credits" Title="Credits" Width="80px" />
                        </Columns>
                    </RadzenDataGrid>
                </div>
            }
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="d-flex flex-column align-items-center justify-content-center portal-loading-container">
            <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Large" />
            <p class="mt-3 text-secondary fw-semibold">Loading Portal...</p>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private Teacher? currentTeacher;
    private List<Course> assignedCourses = new();
    private Dictionary<int, List<StudentEnrollment>> courseEnrollments = new();
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            var userIdStr = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            if (int.TryParse(userIdStr, out int userId))
            {
                currentTeacher = await TeacherService.GetByUserIdAsync(userId);
                if (currentTeacher != null)
                {
                    var timetableEntries = await TimetableService.GetByTeacherAsync(currentTeacher.Id);
                    assignedCourses = timetableEntries.Select(t => t.Course).Distinct().ToList();

                    foreach (var course in assignedCourses)
                    {
                        var enrollments = await EnrollmentService.GetByCourseAsync(course.Id);
                        courseEnrollments[course.Id] = enrollments.Where(e => e.Status == EnrollmentStatus.Active).ToList();
                    }
                }
            }
        }
        loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated != true ||
                authState.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value != "Teacher")
            {
                Navigation.NavigateTo("/login");
            }
        }
    }
}

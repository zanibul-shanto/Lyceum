@page "/teacher/dashboard"
@inject UserService UserService
@inject CustomAuthStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Teacher Dashboard - Lyceum</PageTitle>

<AuthorizeView Roles="Teacher" Context="authContext">
    <Authorized>
        <div class="w-100">
            <!-- Header Section with gradient -->
            <MudPaper Class="pa-6 mb-6 d-flex flex-column flex-md-row justify-between align-start align-md-center gap-4" 
                      Style="background: linear-gradient(135deg, var(--mud-palette-primary) 0%, var(--mud-palette-secondary) 100%); color: white; border-radius: 12px;" Elevation="0">
                <div class="d-flex align-center">
                    <div class="d-flex align-center justify-center rounded-lg mr-4" style="width: 60px; height: 60px; background-color: rgba(255,255,255,0.2); color: white; font-size: 1.8rem;">
                        <MudIcon Icon="@Icons.Material.Filled.CastForEducation" Size="Size.Large" Color="Color.Inherit" />
                    </div>
                    <div>
                        <MudChip T="string" Size="Size.Small" Style="background-color: rgba(255,255,255,0.2); color: white; font-weight: bold;" Class="mb-1 border-0">Teacher Profile</MudChip>
                        <MudText Typo="Typo.h4" Class="font-weight-bold" Style="font-family: 'Outfit', sans-serif;">@currentTeacher?.FullName</MudText>
                        <MudText Typo="Typo.body2" Style="color: rgba(255,255,255,0.8);">@currentTeacher?.Department | ID: @currentTeacher?.TeacherId</MudText>
                    </div>
                </div>
                <MudPaper Class="pa-3 rounded-lg" Style="background: rgba(255,255,255,0.15); border: 1px solid rgba(255,255,255,0.15);" Elevation="0">
                    <MudText Typo="Typo.caption" Style="color: rgba(255,255,255,0.7); display: block;">Office Room</MudText>
                    <MudText Typo="Typo.body2" Class="font-weight-bold" Style="color: white;">
                        <MudIcon Icon="@Icons.Material.Filled.Room" Size="Size.Small" Class="mr-1" Style="vertical-align: text-bottom;" />
                        @(currentTeacher?.OfficeRoom ?? "Not Assigned")
                    </MudText>
                </MudPaper>
            </MudPaper>

            <!-- Bio and Quick Stats Grid -->
            <MudGrid Class="mb-6">
                <MudItem XS="12" MD="8">
                    <MudCard Outlined="true" Class="pa-6 border" Style="background-color: white; border-radius: 12px; height: 100%;">
                        <div class="d-flex align-center mb-3">
                            <MudIcon Icon="@Icons.Material.Filled.FilePresent" Color="Color.Primary" Class="mr-2" />
                            <MudText Typo="Typo.h6" Class="font-weight-bold" Style="font-family: 'Outfit', sans-serif;">Professional Bio</MudText>
                        </div>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Style="line-height: 1.6;">
                            @(currentTeacher?.Bio ?? "No professional bio provided yet. Update your profile info in the administration panel to include academic background and research interests.")
                        </MudText>
                    </MudCard>
                </MudItem>
                <MudItem XS="12" MD="4">
                    <MudGrid Style="height: 100%;">
                        <MudItem XS="6">
                            <MudPaper Class="pa-4 border d-flex flex-column justify-center align-center" Elevation="0" Style="background-color: white; height: 100%; border-radius: 12px; min-height: 90px;">
                                <MudText Typo="Typo.overline" Color="Color.Secondary" Style="font-weight: 700;">Students</MudText>
                                <MudText Typo="Typo.h4" Class="font-weight-bold" Color="Color.Primary" Style="font-family: 'Outfit', sans-serif;">@students.Count</MudText>
                            </MudPaper>
                        </MudItem>
                        <MudItem XS="6">
                            <MudPaper Class="pa-4 border d-flex flex-column justify-center align-center" Elevation="0" Style="background-color: white; height: 100%; border-radius: 12px; min-height: 90px;">
                                <MudText Typo="Typo.overline" Color="Color.Secondary" Style="font-weight: 700;">Avg GPA</MudText>
                                <MudText Typo="Typo.h4" Class="font-weight-bold" Color="Color.Success" Style="font-family: 'Outfit', sans-serif;">@averageGpa.ToString("0.00")</MudText>
                            </MudPaper>
                        </MudItem>
                        <MudItem XS="12">
                            <MudPaper Class="pa-4 border d-flex align-center gap-3" Elevation="0" Style="background-color: white; border-radius: 12px;">
                                <div class="d-flex align-center justify-center rounded-lg" style="width: 40px; height: 40px; background-color: var(--mud-palette-warning-lighten); color: var(--mud-palette-warning);">
                                    <MudIcon Icon="@Icons.Material.Filled.AccessTime" />
                                </div>
                                <div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-weight: 700; text-transform: uppercase;">Consultation Hours</MudText>
                                    <MudText Typo="Typo.body2" Class="font-weight-bold">Mon, Wed • 2:00 PM - 4:00 PM</MudText>
                                </div>
                            </MudPaper>
                        </MudItem>
                    </MudGrid>
                </MudItem>
            </MudGrid>

            <!-- Student Roster Table -->
            <MudCard Class="border mb-4" Elevation="0" Style="background-color: white; border-radius: 12px;">
                <MudCardHeader Class="pb-2">
                    <CardHeaderContent>
                        <MudText Typo="Typo.h5" Class="font-weight-bold" Style="font-family: 'Outfit', sans-serif;">Academic Student Roster</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">List of students currently registered under your academic department.</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent Class="pa-0">
                    <MudTable Items="students" Elevation="0" Class="border-0">
                        <HeaderContent>
                            <MudTh>Student Info</MudTh>
                            <MudTh>Student ID</MudTh>
                            <MudTh>Grade Level</MudTh>
                            <MudTh>Attendance</MudTh>
                            <MudTh>GPA</MudTh>
                            <MudTh Style="text-align: right;">Academic Action</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Student Info">
                                <div class="d-flex align-center">
                                    <MudAvatar Color="Color.Primary" Variant="Variant.Text" Class="mr-3" Style="background-color: var(--mud-palette-primary-lighten); font-weight: bold; border-radius: 8px;">
                                        <MudIcon Icon="@Icons.Material.Filled.Person" />
                                    </MudAvatar>
                                    <div>
                                        <MudText Typo="Typo.body2" Class="font-weight-bold">@context.FullName</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Email</MudText>
                                    </div>
                                </div>
                            </MudTd>
                            <MudTd DataLabel="Student ID" Style="font-weight: 600;">@(context.StudentId ?? "Not Assigned")</MudTd>
                            <MudTd DataLabel="Grade Level">@(context.GradeLevel ?? "Unspecified")</MudTd>
                            <MudTd DataLabel="Attendance">
                                <div class="d-flex align-center">
                                    <MudProgressLinear Color="Color.Success" Value="@((double)(context.AttendanceRate ?? 100.0))" Class="mr-2" Style="width: 60px; height: 6px; border-radius: 3px;" />
                                    <span class="font-monospace fw-semibold small">@(context.AttendanceRate?.ToString("0.0") ?? "100.0")%</span>
                                </div>
                            </MudTd>
                            <MudTd DataLabel="GPA">
                                <MudChip T="string" Color="Color.Success" Variant="Variant.Text" Style="font-weight: bold; font-family: monospace;">
                                    @(context.GPA?.ToString("0.00") ?? "0.00")
                                </MudChip>
                            </MudTd>
                            <MudTd DataLabel="Academic Action" Style="text-align: right;">
                                <MudButton OnClick="() => OpenGradeModal(context)" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.RateReview" Size="Size.Small" Style="text-transform: none; border-radius: 8px;">
                                    Grade Student
                                </MudButton>
                            </MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <div class="text-center py-6 text-secondary">
                                <MudIcon Icon="@Icons.Material.Filled.PeopleOutline" Style="font-size: 2.5rem;" Color="Color.Default" Class="mb-2" />
                                <MudText Typo="Typo.body2" Style="font-weight: bold;">No students currently registered in the database.</MudText>
                            </div>
                        </NoRecordsContent>
                    </MudTable>
                </MudCardContent>
            </MudCard>

            <!-- Dialog: Grade Student -->
            <MudDialog @bind-Visible="isGradeModalVisible" Options="_dialogOptions">
                <TitleContent>
                    <MudText Typo="Typo.h6" Class="font-weight-bold" Style="font-family: 'Outfit', sans-serif;">Grade Evaluation</MudText>
                </TitleContent>
                <DialogContent>
                    <div class="text-center mb-6 mt-2">
                        <MudAvatar Color="Color.Primary" Variant="Variant.Text" Class="mx-auto mb-2" Style="background-color: var(--mud-palette-primary-lighten); width: 50px; height: 50px;">
                            <MudIcon Icon="@Icons.Material.Filled.AssignmentInd" Size="Size.Medium" />
                        </MudAvatar>
                        <MudText Typo="Typo.h6" Class="font-weight-bold">@gradingStudent?.FullName</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">ID: @gradingStudent?.StudentId</MudText>
                    </div>

                    <div class="mb-4">
                        <MudNumericField T="double" Label="Student Grade Point Average (GPA)" @bind-Value="tempGpa" 
                                         Min="0.0" Max="4.0" Step="0.01" Format="0.00" Required="true" 
                                         Variant="Variant.Outlined" Margin="Margin.Dense" HelperText="GPA scale must be between 0.00 and 4.00." />
                    </div>

                    <div class="mb-2">
                        <MudNumericField T="double" Label="Class Attendance Rate (%)" @bind-Value="tempAttendance" 
                                         Min="0.0" Max="100.0" Step="0.1" Format="0.0" Required="true" 
                                         Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </div>
                </DialogContent>
                <DialogActions>
                    <MudButton OnClick="CloseGradeModal" Variant="Variant.Text" Color="Color.Secondary" Style="text-transform: none; font-weight: bold;">Cancel</MudButton>
                    <MudButton OnClick="SaveStudentGrade" Variant="Variant.Filled" Color="Color.Primary" Style="text-transform: none; font-weight: bold; border-radius: 8px;">Apply Grades</MudButton>
                </DialogActions>
            </MudDialog>
        </div>
    </Authorized>
    <NotAuthorized>
        <!-- Premium Loader during pre-render session loading -->
        <div class="d-flex flex-column align-center justify-center" style="min-height: 80vh;">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
            <MudText Class="mt-4 text-secondary font-weight-bold">Loading Teacher Portal...</MudText>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private User? currentTeacher;
    private List<User> students = new();
    private double averageGpa = 0.0;

    // Grade Evaluation Modal States
    private bool isGradeModalVisible;
    private User? gradingStudent;
    private double tempGpa;
    private double tempAttendance;

    private readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var username = authState.User.Identity?.Name;
        
        if (!string.IsNullOrEmpty(username))
        {
            var allUsers = await UserService.GetAllUsersAsync();
            currentTeacher = allUsers.FirstOrDefault(u => u.Username.ToLower() == username.ToLower());
        }

        await LoadStudentsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated != true)
            {
                Navigation.NavigateTo("/login");
            }
            else
            {
                var role = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
                if (role != "Teacher")
                {
                    Navigation.NavigateTo("/login");
                }
            }
        }
    }

    private async Task LoadStudentsAsync()
    {
        students = await UserService.GetUsersByRoleAsync(UserRole.Student);
        
        if (students.Any())
        {
            averageGpa = students.Average(s => s.GPA ?? 0.0);
        }
    }

    private void OpenGradeModal(User student)
    {
        gradingStudent = student;
        tempGpa = student.GPA ?? 0.0;
        tempAttendance = student.AttendanceRate ?? 100.0;
        isGradeModalVisible = true;
    }

    private void CloseGradeModal()
    {
        isGradeModalVisible = false;
        gradingStudent = null;
    }

    private async Task SaveStudentGrade()
    {
        if (gradingStudent != null)
        {
            gradingStudent.GPA = Math.Max(0.0, Math.Min(4.0, tempGpa));
            gradingStudent.AttendanceRate = Math.Max(0.0, Math.Min(100.0, tempAttendance));

            await UserService.UpdateUserAsync(gradingStudent);
            CloseGradeModal();
            await LoadStudentsAsync();
        }
    }
}

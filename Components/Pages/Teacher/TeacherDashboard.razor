@page "/teacher/dashboard"
@inject UserService UserService
@inject TeacherService TeacherService
@inject CourseService CourseService
@inject StudentService StudentService
@inject GradeService GradeService
@inject AttendanceService AttendanceService
@inject TimetableService TimetableService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject DialogService DialogService

<PageTitle>Teacher Dashboard - Lyceum</PageTitle>

<AuthorizeView Roles="Teacher" Context="authContext">
    <Authorized>
        <div class="container-fluid py-4 px-xl-5">
            <!-- Profile Header -->
            <div class="profile-header-gradient d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                <div class="d-flex align-items-center">
                    <div class="stat-icon mb-0 me-3 shadow teacher-profile-icon">
                        <i class="bi bi-person-workspace"></i>
                    </div>
                    <div>
                        <span class="badge fw-bold text-uppercase small teacher-badge">Teacher Profile</span>
                        <h2 class="fw-bold mb-0 text-white mt-1">@currentTeacher?.User?.FullName</h2>
                        <p class="mb-0 small teacher-subtitle">
                            @(currentTeacher?.Department ?? "No Department Assigned") | ID: @currentTeacher?.TeacherCode
                        </p>
                    </div>
                </div>
                <div class="text-md-end p-3 rounded-3 office-box">
                    <div class="small office-label">Office Room</div>
                    <div class="fw-bold text-white">
                        <i class="bi bi-geo-alt-fill me-1"></i>
                        @(currentTeacher?.OfficeRoom ?? "Not Assigned")
                    </div>
                </div>
            </div>

            <div class="row g-4 mb-4">
                <!-- Bio Card -->
                <div class="col-12 col-lg-4">
                    <div class="dashboard-card h-100 p-4">
                        <h5 class="fw-bold text-dark mb-3">
                            <i class="bi bi-file-person text-primary me-2"></i> Professional Bio
                        </h5>
                        <p class="text-secondary mb-0 small bio-text">
                            @(currentTeacher?.Bio ?? "No professional bio provided yet. Update your profile in the administration panel.")
                        </p>
                    </div>
                </div>

                <!-- GPA Distribution Chart Card -->
                <div class="col-12 col-lg-4">
                    <div class="dashboard-card h-100 p-4">
                        <h5 class="fw-bold text-dark mb-3">
                            <i class="bi bi-bar-chart-line text-success me-2"></i> Enrolled Students GPA
                        </h5>
                        @if (gpaChartData.Any(c => c.Count > 0))
                        {
                            <RadzenChart class="teacher-gpa-chart">
                                <RadzenColumnSeries Data="@gpaChartData" CategoryProperty="Range" ValueProperty="Count" Title="Students" />
                                <RadzenValueAxis Min="0" Step="1" />
                            </RadzenChart>
                        }
                        else
                        {
                            <p class="text-secondary small mb-0">No student GPAs recorded.</p>
                        }
                    </div>
                </div>

                <!-- Quick Stats -->
                <div class="col-12 col-lg-4">
                    <div class="row g-3 h-100">
                        <div class="col-6">
                            <div class="dashboard-card p-3 h-100 d-flex flex-column justify-content-center">
                                <span class="kpi-label">Assigned Courses</span>
                                <div class="kpi-number">@assignedCourses.Count</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="dashboard-card p-3 h-100 d-flex flex-column justify-content-center">
                                <span class="kpi-label">Enrolled Students</span>
                                <div class="kpi-number">@totalEnrolledStudents</div>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="dashboard-card p-3 d-flex align-items-center gap-3">
                                <div class="stat-icon bg-success-subtle text-success mb-0 stat-icon-square">
                                    <i class="bi bi-journal-check"></i>
                                </div>
                                <div>
                                    <span class="text-secondary small fw-semibold">Class Avg GPA</span>
                                    <div class="kpi-number mb-0" style="font-size: 1.5rem; line-height: 1;">@averageGpa.ToString("0.00")</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Assigned Courses & Timetable Section -->
            <div class="row g-4 mb-4">
                <!-- Assigned Courses Grid -->
                <div class="col-12 col-xl-7">
                    <div class="dashboard-card p-4 h-100">
                        <h4 class="fw-bold mb-3 page-title-modern text-dark" style="font-size:1.15rem;">
                            <i class="bi bi-journal-bookmark-fill text-primary me-2"></i>Assigned Courses
                        </h4>
                        <RadzenDataGrid Data="@assignedCourses" TItem="Course" AllowSorting="true" AllowPaging="true" PageSize="5" GridLines="DataGridGridLines.Horizontal">
                            <Columns>
                                <RadzenDataGridColumn TItem="Course" Property="CourseCode" Title="Code" Width="100px" />
                                <RadzenDataGridColumn TItem="Course" Property="Name" Title="Name" />
                                <RadzenDataGridColumn TItem="Course" Property="Credits" Title="Credits" Width="80px" TextAlign="TextAlign.Center" />
                                <RadzenDataGridColumn TItem="Course" Title="Enrolled" Width="100px" TextAlign="TextAlign.Center">
                                    <Template Context="course">
                                        <span class="badge bg-secondary text-white">@course.Enrollments.Count / @course.MaxCapacity</span>
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    </div>
                </div>

                <!-- Upcoming Class Sessions (Timetable) -->
                <div class="col-12 col-xl-5">
                    <div class="dashboard-card p-4 h-100">
                        <h4 class="fw-bold mb-3 page-title-modern text-dark" style="font-size:1.15rem;">
                            <i class="bi bi-calendar3 text-warning me-2"></i>Upcoming Class Sessions
                        </h4>
                        <RadzenDataGrid Data="@upcomingSessions" TItem="Timetable" AllowSorting="true" AllowPaging="true" PageSize="5" GridLines="DataGridGridLines.Horizontal">
                            <Columns>
                                <RadzenDataGridColumn TItem="Timetable" Property="DayOfWeek" Title="Day" Width="110px">
                                    <Template Context="session">
                                        <span class="badge bg-info text-dark">@session.DayOfWeek.ToString()</span>
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="Timetable" Title="Time">
                                    <Template Context="session">
                                        <span class="text-dark">@session.StartTime.ToString("hh:mm tt") - @session.EndTime.ToString("hh:mm tt")</span>
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="Timetable" Property="Course.CourseCode" Title="Course" />
                                <RadzenDataGridColumn TItem="Timetable" Property="RoomNumber" Title="Room" Width="90px" />
                            </Columns>
                        </RadzenDataGrid>
                    </div>
                </div>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="d-flex flex-column align-items-center justify-content-center portal-loading-container">
            <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate"
                                       Size="ProgressBarCircularSize.Large" />
            <p class="mt-3 text-secondary fw-semibold">Loading Teacher Portal...</p>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private Teacher? currentTeacher;
    private List<Course> assignedCourses = new();
    private List<Timetable> upcomingSessions = new();
    private int totalEnrolledStudents = 0;
    private double averageGpa = 0.0;
    private List<GpaChartItem> gpaChartData = new();

    public class GpaChartItem
    {
        public string Range { get; set; } = string.Empty;
        public int Count { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var username = authState.User.Identity?.Name;

        if (!string.IsNullOrEmpty(username))
        {
            var userIdClaim = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
            if (userIdClaim != null && int.TryParse(userIdClaim.Value, out var userId))
            {
                currentTeacher = await TeacherService.GetByUserIdAsync(userId);
            }
        }

        await LoadDashboardDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated != true)
            {
                Navigation.NavigateTo("/login");
            }
            else
            {
                var role = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
                if (role != "Teacher")
                    Navigation.NavigateTo("/login");
            }
        }
    }

    private async Task LoadDashboardDataAsync()
    {
        if (currentTeacher == null) return;

        // Fetch assigned courses from timetable entries
        var timetableEntries = await TimetableService.GetByTeacherAsync(currentTeacher.Id);
        assignedCourses = timetableEntries.Select(t => t.Course).Distinct().ToList();
        upcomingSessions = timetableEntries;

        var uniqueStudentsList = new HashSet<int>();
        var teacherGrades = new List<Grade>();

        foreach (var course in assignedCourses)
        {
            var courseDetails = await CourseService.GetByIdAsync(course.Id);
            if (courseDetails != null)
            {
                foreach (var enrollment in courseDetails.Enrollments)
                {
                    if (enrollment.Status == EnrollmentStatus.Active)
                    {
                        uniqueStudentsList.Add(enrollment.StudentId);
                    }
                }

                var courseGrades = await GradeService.GetByCourseAsync(course.Id);
                teacherGrades.AddRange(courseGrades);
            }
        }

        totalEnrolledStudents = uniqueStudentsList.Count;

        // Class average GPA (weighted average of grades)
        double totalCredits = 0;
        double weightedSum = 0;
        foreach (var g in teacherGrades)
        {
            weightedSum += g.GradePoints * g.Course.Credits;
            totalCredits += g.Course.Credits;
        }

        if (totalCredits > 0)
        {
            averageGpa = Math.Round(weightedSum / totalCredits, 2);
        }
        else
        {
            averageGpa = 0.0;
        }

        // Fetch student GPAs to build GPA distribution chart data
        var studentGpas = new List<double>();
        foreach (var studentId in uniqueStudentsList)
        {
            var studentGpa = await GradeService.CalculateGPAAsync(studentId);
            studentGpas.Add(studentGpa);
        }

        if (studentGpas.Any())
        {
            gpaChartData = new List<GpaChartItem>
            {
                new() { Range = "3.5 - 4.0", Count = studentGpas.Count(g => g >= 3.5) },
                new() { Range = "3.0 - 3.49", Count = studentGpas.Count(g => g >= 3.0 && g < 3.5) },
                new() { Range = "2.0 - 2.99", Count = studentGpas.Count(g => g >= 2.0 && g < 3.0) },
                new() { Range = "< 2.0", Count = studentGpas.Count(g => g < 2.0) }
            };
        }
        else
        {
            gpaChartData = new();
        }
    }
}

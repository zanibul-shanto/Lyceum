@page "/teacher/dashboard"
@inject UserService UserService
@inject CustomAuthStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject DialogService DialogService

<PageTitle>Teacher Dashboard - Lyceum</PageTitle>

<AuthorizeView Roles="Teacher" Context="authContext">
    <Authorized>
        <div class="container-fluid py-4 px-xl-5">
            <!-- Profile Header -->
            <div class="profile-header-gradient d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                <div class="d-flex align-items-center">
                    <div class="stat-icon mb-0 me-3 shadow teacher-profile-icon">
                        <i class="bi bi-person-workspace"></i>
                    </div>
                    <div>
                        <span class="badge fw-bold text-uppercase small teacher-badge">Teacher Profile</span>
                        <h2 class="fw-bold mb-0 text-white mt-1">@currentTeacher?.FullName</h2>
                        <p class="mb-0 small teacher-subtitle">
                            @currentTeacher?.Department | ID: @currentTeacher?.TeacherId
                        </p>
                    </div>
                </div>
                <div class="text-md-end p-3 rounded-3 office-box">
                    <div class="small office-label">Office Room</div>
                    <div class="fw-bold text-white">
                        <i class="bi bi-geo-alt-fill me-1"></i>
                        @(currentTeacher?.OfficeRoom ?? "Not Assigned")
                    </div>
                </div>
            </div>

            <div class="row g-4 mb-4">
                <!-- Bio Card -->
                <div class="col-12 col-lg-4">
                    <div class="dashboard-card h-100 p-4">
                        <h5 class="fw-bold text-dark mb-3">
                            <i class="bi bi-file-person text-primary me-2"></i> Professional Bio
                        </h5>
                        <p class="text-secondary mb-0 small bio-text">
                            @(currentTeacher?.Bio ?? "No professional bio provided yet. Update your profile in the administration panel.")
                        </p>
                    </div>
                </div>

                <!-- GPA Distribution Chart Card -->
                <div class="col-12 col-lg-4">
                    <div class="dashboard-card h-100 p-4">
                        <h5 class="fw-bold text-dark mb-3">
                            <i class="bi bi-bar-chart-line text-success me-2"></i> GPA Distribution
                        </h5>
                        @if (gpaChartData.Any())
                        {
                            <RadzenChart class="teacher-gpa-chart">
                                <RadzenColumnSeries Data="@gpaChartData" CategoryProperty="Range" ValueProperty="Count" Title="Students" />
                                <RadzenValueAxis Min="0" Step="1" />
                            </RadzenChart>
                        }
                        else
                        {
                            <p class="text-secondary small mb-0">No student GPAs recorded.</p>
                        }
                    </div>
                </div>

                <!-- Quick Stats -->
                <div class="col-12 col-lg-4">
                    <div class="row g-3 h-100">
                        <div class="col-6">
                            <div class="dashboard-card p-3 h-100 d-flex flex-column justify-content-center">
                                <span class="kpi-label">Students</span>
                                <div class="kpi-number">@students.Count</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="dashboard-card p-3 h-100 d-flex flex-column justify-content-center">
                                <span class="kpi-label">Avg GPA</span>
                                <div class="kpi-number">@averageGpa.ToString("0.00")</div>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="dashboard-card p-3 d-flex align-items-center gap-3">
                                <div class="stat-icon bg-warning-subtle text-warning mb-0 stat-icon-square">
                                    <i class="bi bi-clock-history"></i>
                                </div>
                                <div>
                                    <span class="text-secondary small fw-semibold">Consultation Hours</span>
                                    <div class="fw-bold text-dark small">Mon, Wed • 2:00 PM – 4:00 PM</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Student Roster -->
            <div class="dashboard-card p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h4 class="fw-bold mb-1 page-title-modern" style="font-size:1.15rem;">Academic Student Roster</h4>
                        <p class="page-subtitle-modern mb-0">
                            Students currently registered under your academic department.
                        </p>
                    </div>
                </div>

                <RadzenDataGrid Data="@students" TItem="User" AllowSorting="true" AllowPaging="true"
                                PageSize="10" GridLines="DataGridGridLines.Horizontal">
                    <Columns>
                        <RadzenDataGridColumn TItem="User" Title="Student Info" Sortable="false">
                            <Template Context="student">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="stat-icon bg-primary-subtle text-primary mb-0 d-none d-sm-flex student-icon-small">
                                        <i class="bi bi-person-fill"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark">@student.FullName</div>
                                        <div class="text-secondary small">@student.Email</div>
                                    </div>
                                </div>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="User" Property="StudentId" Title="Student ID">
                            <Template Context="student">
                                <span class="fw-semibold">@(student.StudentId ?? "Not Assigned")</span>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="User" Property="GradeLevel" Title="Grade Level">
                            <Template Context="student">
                                <span class="text-secondary small">@(student.GradeLevel ?? "Unspecified")</span>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="User" Property="AttendanceRate" Title="Attendance">
                            <Template Context="student">
                                <div class="d-flex align-items-center gap-2">
                                    <RadzenProgressBar Value="@(student.AttendanceRate ?? 100)"
                                                       ShowValue="false" class="progress-bar-small" />
                                    <span class="fw-semibold font-monospace small">
                                        @(student.AttendanceRate?.ToString("0.0") ?? "100.0")%
                                    </span>
                                </div>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="User" Property="GPA" Title="GPA" Width="90px">
                            <Template Context="student">
                                <span class="badge bg-success-subtle text-success font-monospace px-2 py-1">
                                    @(student.GPA?.ToString("0.00") ?? "0.00")
                                </span>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="User" Title="" Width="140px" Sortable="false" TextAlign="TextAlign.End">
                            <Template Context="student">
                                <RadzenButton Text="Grade" Icon="grading" Click="@(() => OpenGradeModal(student))"
                                              ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" />
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="d-flex flex-column align-items-center justify-content-center portal-loading-container">
            <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate"
                                       Size="ProgressBarCircularSize.Large" />
            <p class="mt-3 text-secondary fw-semibold">Loading Teacher Portal...</p>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private User? currentTeacher;
    private List<User> students = new();
    private double averageGpa = 0.0;

    private List<GpaChartItem> gpaChartData = new();

    public class GpaChartItem
    {
        public string Range { get; set; } = string.Empty;
        public int Count { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var username = authState.User.Identity?.Name;

        if (!string.IsNullOrEmpty(username))
        {
            var allUsers = await UserService.GetAllUsersAsync();
            currentTeacher = allUsers.FirstOrDefault(u => u.Username.ToLower() == username.ToLower());
        }

        await LoadStudentsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated != true)
            {
                Navigation.NavigateTo("/login");
            }
            else
            {
                var role = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
                if (role != "Teacher")
                    Navigation.NavigateTo("/login");
            }
        }
    }

    private async Task LoadStudentsAsync()
    {
        students = await UserService.GetUsersByRoleAsync(UserRole.Student);
        if (students.Any())
        {
            averageGpa = students.Average(s => s.GPA ?? 0.0);

            gpaChartData = new List<GpaChartItem>
            {
                new() { Range = "3.5 - 4.0", Count = students.Count(s => (s.GPA ?? 0.0) >= 3.5) },
                new() { Range = "3.0 - 3.49", Count = students.Count(s => (s.GPA ?? 0.0) >= 3.0 && (s.GPA ?? 0.0) < 3.5) },
                new() { Range = "2.0 - 2.99", Count = students.Count(s => (s.GPA ?? 0.0) >= 2.0 && (s.GPA ?? 0.0) < 3.0) },
                new() { Range = "< 2.0", Count = students.Count(s => (s.GPA ?? 0.0) < 2.0) }
            };
        }
        else
        {
            averageGpa = 0.0;
            gpaChartData = new();
        }
    }

    private async Task OpenGradeModal(User student)
    {
        // Clone the student to prevent dirtying dashboard state before database commit
        var studentClone = new User
        {
            Id = student.Id,
            Username = student.Username,
            FullName = student.FullName,
            Email = student.Email,
            Role = student.Role,
            CreatedAt = student.CreatedAt,
            StudentId = student.StudentId,
            GradeLevel = student.GradeLevel,
            GPA = student.GPA,
            AttendanceRate = student.AttendanceRate
        };

        var result = await DialogService.OpenAsync<GradeDialog>("Grade Evaluation",
            new Dictionary<string, object?> { { "Student", studentClone } },
            new DialogOptions { Width = "480px", Resizable = false, CloseDialogOnOverlayClick = true });

        if (result == true)
        {
            await LoadStudentsAsync();
        }
    }
}

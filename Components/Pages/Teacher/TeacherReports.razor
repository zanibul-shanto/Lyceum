@page "/teacher/reports"
@inject TeacherService TeacherService
@inject TimetableService TimetableService
@inject ReportService ReportService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject NotificationService NotificationService
@inject IJSRuntime JS

<PageTitle>Class Reports - Lyceum</PageTitle>

<AuthorizeView Roles="Teacher">
    <Authorized>
        <div class="container-fluid py-4 px-xl-5">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h3 class="fw-bold mb-1 page-title-modern text-white">Class Reports</h3>
                    <p class="page-subtitle-modern mb-0 text-secondary">Generate and download academic performance and attendance PDF reports for your classes.</p>
                </div>
            </div>

            <div class="row g-4">
                <!-- Select Course Card -->
                <div class="col-12 col-lg-6">
                    <div class="dashboard-card p-4 h-100">
                        <h5 class="fw-bold mb-3 text-dark"><i class="bi bi-file-earmark-pdf text-danger me-2"></i>Report Generator</h5>
                        <p class="text-secondary small mb-4">Choose one of your assigned courses below, then click to generate the desired PDF report.</p>

                        <div class="mb-4">
                            <label class="form-label text-secondary fw-semibold small">Select Course</label>
                            <RadzenDropDown TValue="int?" Value="@selectedCourseId" Data="@assignedCourses" 
                                            TextProperty="Name" ValueProperty="Id" 
                                            Change="@(args => selectedCourseId = (int?)args)" 
                                            Placeholder="Choose a course..." class="w-100" />
                        </div>

                        <div class="d-flex flex-column gap-3 mt-4">
                            <RadzenButton Text="Generate Class Attendance Report" Icon="calendar_today" 
                                          Click="DownloadAttendanceReport" 
                                          ButtonStyle="ButtonStyle.Success" class="w-100 py-2 justify-content-start"
                                          Disabled="@(!selectedCourseId.HasValue || generating)" />

                            <RadzenButton Text="Generate Class Result Report" Icon="assignment_turned_in" 
                                          Click="DownloadResultReport" 
                                          ButtonStyle="ButtonStyle.Primary" class="w-100 py-2 justify-content-start"
                                          Disabled="@(!selectedCourseId.HasValue || generating)" />
                        </div>

                        @if (generating)
                        {
                            <div class="d-flex align-items-center gap-2 mt-4 text-primary">
                                <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
                                <span class="small fw-semibold">Generating PDF report, please wait...</span>
                            </div>
                        }
                    </div>
                </div>

                <!-- Info Card -->
                <div class="col-12 col-lg-6">
                    <div class="dashboard-card p-4 h-100 border border-primary-subtle bg-light-subtle">
                        <h5 class="fw-bold mb-3 text-primary"><i class="bi bi-info-circle me-2"></i>Report Details</h5>
                        <div class="d-flex flex-column gap-3">
                            <div class="d-flex gap-3">
                                <div class="stat-icon bg-success-subtle text-success mb-0 d-flex align-items-center justify-content-center" style="width:40px; height:40px; flex-shrink:0;">
                                    <i class="bi bi-calendar-check" style="font-size:1.2rem;"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold text-dark mb-1">Class Attendance Report</h6>
                                    <p class="text-secondary small mb-0">Contains summaries of all recorded attendance sessions, presenting a student-by-student analysis of total sessions, present, absent, and late tallies, along with their aggregate attendance percentage.</p>
                                </div>
                            </div>

                            <hr class="text-secondary opacity-25 my-1" />

                            <div class="d-flex gap-3">
                                <div class="stat-icon bg-primary-subtle text-primary mb-0 d-flex align-items-center justify-content-center" style="width:40px; height:40px; flex-shrink:0;">
                                    <i class="bi bi-award" style="font-size:1.2rem;"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold text-dark mb-1">Class Result Report</h6>
                                    <p class="text-secondary small mb-0">Summarizes current academic grades for all enrolled students, displaying scores for assignments, midterms, final examinations, and weighted totals, complete with corresponding letter grades.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="d-flex flex-column align-items-center justify-content-center portal-loading-container">
            <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Large" />
            <p class="mt-3 text-secondary fw-semibold">Loading Portal...</p>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private Teacher? currentTeacher;
    private List<Course> assignedCourses = new();
    private int? selectedCourseId;
    private bool generating = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            var userIdStr = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            if (int.TryParse(userIdStr, out int userId))
            {
                currentTeacher = await TeacherService.GetByUserIdAsync(userId);
                if (currentTeacher != null)
                {
                    var timetableEntries = await TimetableService.GetByTeacherAsync(currentTeacher.Id);
                    assignedCourses = timetableEntries.Select(t => t.Course).Distinct().ToList();
                }
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated != true ||
                authState.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value != "Teacher")
            {
                Navigation.NavigateTo("/login");
            }
        }
    }

    private async Task DownloadAttendanceReport()
    {
        if (!selectedCourseId.HasValue) return;
        generating = true;
        try
        {
            var bytes = await ReportService.GenerateClassAttendanceReportAsync(selectedCourseId.Value);
            var base64 = Convert.ToBase64String(bytes);
            var course = assignedCourses.FirstOrDefault(c => c.Id == selectedCourseId.Value);
            var filename = $"{course?.CourseCode ?? "Course"}_AttendanceReport_{DateTime.Now:yyyyMMdd}.pdf";
            await JS.InvokeVoidAsync("downloadFileFromBytes", filename, base64);
            NotificationService.Notify(NotificationSeverity.Success, "Success", "Attendance Report generated successfully.");
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", $"Could not generate attendance report: {ex.Message}");
        }
        finally
        {
            generating = false;
        }
    }

    private async Task DownloadResultReport()
    {
        if (!selectedCourseId.HasValue) return;
        generating = true;
        try
        {
            var bytes = await ReportService.GenerateClassResultReportAsync(selectedCourseId.Value);
            var base64 = Convert.ToBase64String(bytes);
            var course = assignedCourses.FirstOrDefault(c => c.Id == selectedCourseId.Value);
            var filename = $"{course?.CourseCode ?? "Course"}_ResultReport_{DateTime.Now:yyyyMMdd}.pdf";
            await JS.InvokeVoidAsync("downloadFileFromBytes", filename, base64);
            NotificationService.Notify(NotificationSeverity.Success, "Success", "Class Result Report generated successfully.");
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", $"Could not generate result report: {ex.Message}");
        }
        finally
        {
            generating = false;
        }
    }
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="_content/Radzen.Blazor/css/default-base.css" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Lyceum.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <title>Lyceum</title>
    <HeadOutlet />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <RadzenComponents @rendermode="InteractiveServer" />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="_content/Radzen.Blazor/Radzen.Blazor.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/face-api.js@0.22.2/dist/face-api.min.js"></script>
    <script>
        window.downloadFileFromBytes = (filename, contentBase64) => {
            const link = document.createElement('a');
            link.download = filename;
            link.href = "data:application/pdf;base64," + contentBase64;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        };

        const FACE_MODEL_URL = 'https://cdn.jsdelivr.net/gh/justadudewhohacks/face-api.js@0.22.2/weights';
        let faceModelsLoaded = false;
        let attendanceLoop = null;
        let activeStream = null;

        window.loadFaceApiModels = async () => {
            if (faceModelsLoaded) return;
            await Promise.all([
                faceapi.loadTinyFaceDetectorModel(FACE_MODEL_URL),
                faceapi.loadFaceLandmarkTinyModel(FACE_MODEL_URL),
                faceapi.loadFaceRecognitionModel(FACE_MODEL_URL)
            ]);
            faceModelsLoaded = true;
        };

        window.extractFaceDescriptor = async (dataUrl) => {
            await window.loadFaceApiModels();
            const img = await faceapi.fetchImage(dataUrl);
            const detection = await faceapi
                .detectSingleFace(img, new faceapi.TinyFaceDetectorOptions())
                .withFaceLandmarks(true)
                .withFaceDescriptor();
            return detection ? Array.from(detection.descriptor) : null;
        };

        window.startAutoAttendance = async (videoId, descriptorsJson, dotNetRef) => {
            await window.loadFaceApiModels();
            const entries = JSON.parse(descriptorsJson);
            if (entries.length === 0) return;
            const labeled = entries.map(d =>
                new faceapi.LabeledFaceDescriptors(String(d.studentId), [new Float32Array(d.descriptor)])
            );
            const matcher = new faceapi.FaceMatcher(labeled, 0.55);
            const video = document.getElementById(videoId);
            activeStream = await navigator.mediaDevices.getUserMedia({ video: true });
            video.srcObject = activeStream;
            await new Promise(r => { video.onloadedmetadata = r; });
            video.play();
            attendanceLoop = setInterval(async () => {
                const detections = await faceapi
                    .detectAllFaces(video, new faceapi.TinyFaceDetectorOptions())
                    .withFaceLandmarks(true)
                    .withFaceDescriptors();
                for (const d of detections) {
                    const match = matcher.findBestMatch(d.descriptor);
                    if (match.label !== 'unknown') {
                        await dotNetRef.invokeMethodAsync('OnFaceDetected', parseInt(match.label));
                    }
                }
            }, 1200);
        };

        window.stopAutoAttendance = () => {
            if (attendanceLoop) { clearInterval(attendanceLoop); attendanceLoop = null; }
            if (activeStream) { activeStream.getTracks().forEach(t => t.stop()); activeStream = null; }
        };

        window.readFileAsDataUrl = (inputFile) => {
            return new Promise((resolve, reject) => {
                const reader = new FileReader();
                reader.onload = () => resolve(reader.result);
                reader.onerror = reject;
                reader.readAsDataURL(inputFile);
            });
        };
    </script>
</body>

</html>

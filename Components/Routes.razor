<CascadingAuthenticationState>
    <Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(Pages.NotFound)">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
                <NotAuthorized>
                    <div class="container d-flex align-items-center justify-content-center" style="min-height: 70vh;">
                        <div class="card shadow-lg p-5 text-center border-0" style="max-width: 500px; border-radius: 16px; background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px);">
                            <div class="mb-4">
                                <i class="bi bi-shield-lock text-danger" style="font-size: 4rem;"></i>
                            </div>
                            <h2 class="fw-bold mb-3" style="color: #1e293b; font-family: 'Outfit', sans-serif;">Access Denied</h2>
                            <p class="text-secondary mb-4">You do not have the required permissions to access this page. Please log in with a different account.</p>
                            <a href="/login" class="btn py-2 px-4 fw-semibold shadow-sm" style="background: linear-gradient(135deg, #3b82f6, #1d4ed8); color: white; border-radius: 8px; border: none; transition: transform 0.2s;">
                                Go to Login
                            </a>
                        </div>
                    </div>
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
    </Router>
</CascadingAuthenticationState>


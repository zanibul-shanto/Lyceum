@inject NavigationManager Navigation

<AuthorizeView>
    <Authorized>
        <!-- STUDENT PORTAL -->
        <AuthorizeView Roles="Student" Context="studentCtx">
            <div class="sidebar-section-label">Student Portal</div>
            <RadzenPanelMenu>
                <RadzenPanelMenuItem Text="Dashboard" Icon="grid_view" Path="/student/dashboard" />
                <RadzenPanelMenuItem Text="My Courses" Icon="book" Path="/student/courses" />
                <RadzenPanelMenuItem Text="Attendance" Icon="fact_check" Path="/student/attendance" />
                <RadzenPanelMenuItem Text="Grades" Icon="bar_chart" Path="/student/grades" />
                <RadzenPanelMenuItem Text="Schedule" Icon="calendar_month" Path="/student/schedule" />
            </RadzenPanelMenu>
        </AuthorizeView>

        <!-- TEACHER PORTAL -->
        <AuthorizeView Roles="Teacher" Context="teacherCtx">
            <div class="sidebar-section-label">Teacher Portal</div>
            <RadzenPanelMenu>
                <RadzenPanelMenuItem Text="Dashboard" Icon="grid_view" Path="/teacher/dashboard" />
                <RadzenPanelMenuItem Text="My Courses" Icon="book" Path="/teacher/courses" />
                <RadzenPanelMenuItem Text="Attendance" Icon="fact_check" Path="/teacher/attendance" />
                <RadzenPanelMenuItem Text="AI Attendance" Icon="face" Path="/teacher/auto-attendance" />
                <RadzenPanelMenuItem Text="Grades" Icon="grading" Path="/teacher/grades" />
                <RadzenPanelMenuItem Text="Schedule" Icon="calendar_month" Path="/teacher/schedule" />
                <RadzenPanelMenuItem Text="Reports" Icon="analytics" Path="/teacher/reports" />
            </RadzenPanelMenu>
        </AuthorizeView>

        <!-- ADMIN PORTAL -->
        <AuthorizeView Roles="Admin" Context="adminCtx">
            <div class="sidebar-section-label">Admin Portal</div>
            <RadzenPanelMenu>
                <RadzenPanelMenuItem Text="Dashboard" Icon="dashboard" Path="/admin/dashboard" />
                <RadzenPanelMenuItem Text="Students" Icon="school" Path="/admin/students" />
                <RadzenPanelMenuItem Text="Teachers" Icon="person" Path="/admin/teachers" />
                <RadzenPanelMenuItem Text="Courses" Icon="library_books" Path="/admin/courses" />
                <RadzenPanelMenuItem Text="Timetable" Icon="calendar_today" Path="/admin/timetable" />
                <RadzenPanelMenuItem Text="Audit Logs" Icon="history" Path="/admin/audit-logs" />
                <RadzenPanelMenuItem Text="Settings" Icon="settings" Path="/admin/settings" />
            </RadzenPanelMenu>
        </AuthorizeView>
    </Authorized>
</AuthorizeView>

<AuthorizeView>
    <Authorized>
        <div class="sidebar-logout-block">
            <a href="javascript:void(0)" @onclick="Logout" class="sidebar-logout-link">
                <i class="bi bi-box-arrow-left"></i>
                <span>Log out</span>
            </a>
        </div>
    </Authorized>
</AuthorizeView>

@code {
    private void Logout()
    {
        Navigation.NavigateTo("/api/auth/logout", forceLoad: true);
    }
}

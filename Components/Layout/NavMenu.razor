@inject CustomAuthStateProvider AuthStateProvider
@inject NavigationManager Navigation

<MudNavMenu>
    <AuthorizeView>
        <Authorized>
            <!-- STUDENT PORTAL MENUS -->
            <AuthorizeView Roles="Student" Context="studentCtx">
                <MudText Typo="Typo.overline" Class="px-4 py-2 mt-2 d-block" Color="Color.Secondary" Style="font-weight: 700; letter-spacing: 0.08em;">Student Portal</MudText>
                
                <MudNavLink Href="student/dashboard" Icon="@Icons.Material.Filled.Dashboard" Match="NavLinkMatch.All">
                    Dashboard
                </MudNavLink>
                
                <MudNavLink Href="student/courses" Icon="@Icons.Material.Filled.Book">
                    My Courses
                </MudNavLink>
                
                <MudNavLink Href="student/assignments" Icon="@Icons.Material.Filled.Assignment">
                    Assignments
                </MudNavLink>
                
                <MudNavLink Href="student/grades" Icon="@Icons.Material.Filled.Assessment">
                    Grades
                </MudNavLink>
                
                <MudNavLink Href="student/schedule" Icon="@Icons.Material.Filled.CalendarMonth">
                    Schedule
                </MudNavLink>
                
                <MudNavLink Href="student/messages" Icon="@Icons.Material.Filled.Forum">
                    <div class="d-flex align-center w-100">
                        <span>Messages</span>
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Class="ml-auto mr-0 px-2 py-0" Style="font-size: 0.72rem; height: 18px; font-weight: bold;">2</MudChip>
                    </div>
                </MudNavLink>
            </AuthorizeView>

            <!-- TEACHER PORTAL MENUS -->
            <AuthorizeView Roles="Teacher" Context="teacherCtx">
                <MudText Typo="Typo.overline" Class="px-4 py-2 mt-2 d-block" Color="Color.Secondary" Style="font-weight: 700; letter-spacing: 0.08em;">Teacher Portal</MudText>
                
                <MudNavLink Href="teacher/dashboard" Icon="@Icons.Material.Filled.Dashboard" Match="NavLinkMatch.All">
                    Dashboard
                </MudNavLink>
                
                <MudNavLink Href="teacher/classes" Icon="@Icons.Material.Filled.People">
                    Student Roster
                </MudNavLink>
                
                <MudNavLink Href="teacher/evaluations" Icon="@Icons.Material.Filled.Rule">
                    Evaluations
                </MudNavLink>
                
                <MudNavLink Href="teacher/schedule" Icon="@Icons.Material.Filled.CalendarMonth">
                    Schedule
                </MudNavLink>
            </AuthorizeView>

            <!-- ADMIN PORTAL MENUS -->
            <AuthorizeView Roles="Admin" Context="adminCtx">
                <MudText Typo="Typo.overline" Class="px-4 py-2 mt-2 d-block" Color="Color.Secondary" Style="font-weight: 700; letter-spacing: 0.08em;">Admin Portal</MudText>
                
                <MudNavLink Href="admin/dashboard" Icon="@Icons.Material.Filled.AdminPanelSettings" Match="NavLinkMatch.All">
                    Dashboard
                </MudNavLink>
                
                <MudNavLink Href="admin/users" Icon="@Icons.Material.Filled.People">
                    Manage Directory
                </MudNavLink>

                <MudNavLink Href="admin/courses" Icon="@Icons.Material.Filled.Book">
                    Course Management
                </MudNavLink>

                <MudNavLink Href="admin/settings" Icon="@Icons.Material.Filled.Settings">
                    System Settings
                </MudNavLink>
            </AuthorizeView>

            <MudDivider Class="my-4" />

            <MudNavLink OnClick="Logout" Icon="@Icons.Material.Filled.Logout" IconColor="Color.Error">
                <MudText Color="Color.Error" Style="font-weight: 600;">Log out</MudText>
            </MudNavLink>
        </Authorized>
    </AuthorizeView>
</MudNavMenu>

@code {
    private async Task Logout()
    {
        await AuthStateProvider.MarkUserAsLoggedOut();
        Navigation.NavigateTo("/login");
    }
}

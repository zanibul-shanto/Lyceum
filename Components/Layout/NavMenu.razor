@inject CustomAuthStateProvider AuthStateProvider
@inject NavigationManager Navigation

<AuthorizeView>
    <Authorized>
        <!-- STUDENT PORTAL -->
        <AuthorizeView Roles="Student" Context="studentCtx">
            <div class="sidebar-section-label">Student Portal</div>
            <RadzenPanelMenu>
                <RadzenPanelMenuItem Text="Dashboard" Icon="grid_view" Path="/student/dashboard" />
                <RadzenPanelMenuItem Text="My Courses" Icon="book" Path="/student/courses" />
                <RadzenPanelMenuItem Text="Assignments" Icon="assignment" Path="/student/assignments" />
                <RadzenPanelMenuItem Text="Grades" Icon="bar_chart" Path="/student/grades" />
                <RadzenPanelMenuItem Text="Schedule" Icon="calendar_month" Path="/student/schedule" />
                <RadzenPanelMenuItem Text="Messages" Icon="chat" Path="/student/messages" />
            </RadzenPanelMenu>
        </AuthorizeView>

        <!-- TEACHER PORTAL -->
        <AuthorizeView Roles="Teacher" Context="teacherCtx">
            <div class="sidebar-section-label">Teacher Portal</div>
            <RadzenPanelMenu>
                <RadzenPanelMenuItem Text="Dashboard" Icon="grid_view" Path="/teacher/dashboard" />
                <RadzenPanelMenuItem Text="Student Roster" Icon="people" Path="/teacher/classes" />
                <RadzenPanelMenuItem Text="Evaluations" Icon="grading" Path="/teacher/evaluations" />
                <RadzenPanelMenuItem Text="Schedule" Icon="calendar_month" Path="/teacher/schedule" />
            </RadzenPanelMenu>
        </AuthorizeView>

        <!-- ADMIN PORTAL -->
        <AuthorizeView Roles="Admin" Context="adminCtx">
            <div class="sidebar-section-label">Admin Portal</div>
            <RadzenPanelMenu>
                <RadzenPanelMenuItem Text="Dashboard" Icon="shield" Path="/admin/dashboard" />
                <RadzenPanelMenuItem Text="Manage Directory" Icon="manage_accounts" Path="/admin/users" />
                <RadzenPanelMenuItem Text="Course Management" Icon="library_books" Path="/admin/courses" />
                <RadzenPanelMenuItem Text="System Settings" Icon="settings" Path="/admin/settings" />
            </RadzenPanelMenu>
        </AuthorizeView>
    </Authorized>
</AuthorizeView>

<AuthorizeView>
    <Authorized>
        <div class="sidebar-logout-block">
            <a href="javascript:void(0)" @onclick="Logout" class="sidebar-logout-link">
                <i class="bi bi-box-arrow-left"></i>
                <span>Log out</span>
            </a>
        </div>
    </Authorized>
</AuthorizeView>

@code {
    private async Task Logout()
    {
        await AuthStateProvider.MarkUserAsLoggedOut();
        Navigation.NavigateTo("/login");
    }
}

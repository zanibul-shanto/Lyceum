@inherits LayoutComponentBase
@inject NavigationManager Navigation

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@if (IsAuthPage())
{
    <MudContainer MaxWidth="MaxWidth.False" Class="d-flex align-center justify-center p-0" Style="min-height: 100vh; background-color: var(--mud-palette-background-gray); width: 100%;">
        @Body
    </MudContainer>
}
else
{
    <MudLayout>
        <MudAppBar Elevation="1" Color="Color.Surface">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => ToggleDrawer())" />
            <MudText Typo="Typo.h6" Class="ml-3 font-weight-bold" Color="Color.Primary" Style="font-family: 'Outfit', sans-serif;">Lyceum</MudText>
            <MudSpacer />
            <AuthorizeView>
                <Authorized>
                    <MudText Typo="Typo.body2" Class="mr-4" Color="Color.Secondary">Logged in as: <b>@context.User.Identity?.Name</b></MudText>
                </Authorized>
            </AuthorizeView>
        </MudAppBar>
        <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
            <div class="d-flex align-center pa-4" style="border-bottom: 1px solid var(--mud-palette-divider);">
                <div class="d-flex align-center justify-center rounded-lg mr-3" style="width: 32px; height: 32px; background-color: var(--mud-palette-primary); color: white; font-weight: 800; font-size: 1.15rem; font-family: 'Outfit', sans-serif;">L</div>
                <MudText Typo="Typo.h6" Class="font-weight-bold" Style="font-family: 'Outfit', sans-serif;">Lyceum</MudText>
            </div>
            <NavMenu />
        </MudDrawer>
        <MudMainContent>
            <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-4">
                @Body
            </MudContainer>
        </MudMainContent>
    </MudLayout>
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private bool IsAuthPage()
    {
        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri).ToLower();
        if (relativePath.Contains("?"))
        {
            relativePath = relativePath.Substring(0, relativePath.IndexOf("?"));
        }
        return relativePath == "login" || relativePath == "register";
    }
}
